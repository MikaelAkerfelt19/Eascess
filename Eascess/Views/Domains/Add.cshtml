@model Eascess.Models.AddDomainViewModel
@{
    ViewData["Title"] = "Yeni Site Ekle";
}

<div class="container mt-4" style="max-width:600px;">

    <div class="mb-4">
        <a asp-action="Index" class="text-muted text-decoration-none">← Web Sitelerime Dön</a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <h4 class="mb-1">Yeni Site Ekle</h4>
            <p class="text-muted small mb-4">
                Sitenizi ekledikten sonra size özel bir entegrasyon scripti oluşturulur.
                Bu scripti sitenizin <code>&lt;head&gt;</code> etiketleri arasına yapıştırın.
            </p>

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
            {
                <div class="alert alert-danger">
                    <div asp-validation-summary="All"></div>
                </div>
            }

            <form asp-action="Add" method="post" novalidate>
                @Html.AntiForgeryToken()

                <div class="mb-4">
                    <label asp-for="DomainUrl" class="form-label fw-semibold">
                        Domain Adresi
                    </label>
                    <input asp-for="DomainUrl"
                           class="form-control"
                           placeholder="example.com"
                           autocomplete="off"
                           autofocus />
                    <span asp-validation-for="DomainUrl" class="text-danger small"></span>
                    <div class="form-text">
                        Protokol (https://) olmadan da girebilirsiniz. Örn: <strong>mysite.com</strong>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Site Ekle</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Nasıl Çalışır -->
    <div class="card border-0 shadow-sm mt-3">
        <div class="card-body p-4">
            <h6 class="mb-3">Nasıl Çalışır?</h6>
            <ol class="small text-muted mb-0">
                <li class="mb-2">Sitenizi buraya ekleyin</li>
                <li class="mb-2">Size özel <code>&lt;script&gt;</code> etiketini kopyalayın</li>
                <li class="mb-2">Etiketini sitenizin <code>&lt;head&gt;</code> bölümüne yapıştırın</li>
                <li>Eascess widget'ı otomatik olarak sitenizde belirir</li>
            </ol>
        </div>
    </div>

</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
