@model Eascess.Models.LoginViewModel
@{
    ViewData["Title"] = "Giriş Yap";
    Layout = "_AuthLayout";
}

<div class="auth-card">

    <div class="auth-brand">
        <div class="auth-brand-icon">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 1L3 5v6c0 5.25 3.75 10.15 9 11.32C17.25 21.15 21 16.25 21 11V5L12 1zm0 4a3 3 0 110 6 3 3 0 010-6zm0 8c-2.67 0-8 1.34-8 4v1h16v-1c0-2.66-5.33-4-8-4z"/>
            </svg>
        </div>
        <span class="auth-brand-name">Eascess</span>
    </div>

    <h1 class="auth-heading">Tekrar hoş geldiniz</h1>
    <p class="auth-subheading">Erişilebilirlik panelinize giriş yapın</p>

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
    {
        <div class="alert-danger">
            <div asp-validation-summary="All" class="text-danger"></div>
        </div>
    }

    <form asp-action="Login" asp-controller="Account" method="post" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

        <div class="form-group">
            <label class="form-label" asp-for="Email">E-posta adresi</label>
            <input class="form-control" asp-for="Email" type="email"
                   placeholder="siz@firma.com" autocomplete="email" autofocus />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label class="form-label" asp-for="Password">Şifre</label>
            <input class="form-control" asp-for="Password" type="password"
                   placeholder="••••••••" autocomplete="current-password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="row-between">
            <label class="check-label">
                <input type="checkbox" asp-for="RememberMe" />
                Beni hatırla
            </label>
            <a href="#" class="auth-link">Şifremi unuttum</a>
        </div>

        <button type="submit" class="btn-auth">Giriş Yap</button>
    </form>

    <div class="divider">
        <div class="divider-line"></div>
        <span class="divider-text">Eascess'e yeni misiniz?</span>
        <div class="divider-line"></div>
    </div>

    <p class="auth-footer-text">
        Hesabınız yok mu? <a asp-action="Register" asp-controller="Account">Ücretsiz hesap oluşturun</a>
    </p>

</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
