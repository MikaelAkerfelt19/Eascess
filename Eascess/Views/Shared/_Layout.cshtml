<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Eascess</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&family=JetBrains+Mono&display=swap">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <a href="#main-content" class="ea-skip-link">İçeriğe geç</a>

    <!-- Pazarlama Navbar -->
    <nav class="ea-navbar" aria-label="Ana gezinme">
        <a class="ea-navbar__brand" asp-controller="Home" asp-action="Index">
            <div class="ea-navbar__logo">
                <img src="~/image/Eascess_logo.png" alt="" />
            </div>
            <span class="ea-navbar__brand-name">Eascess</span>
        </a>

        <div class="ea-navbar__links">
            <a asp-controller="Home" asp-action="Index">Ürün</a>
            <a asp-controller="Home" asp-action="Wcag">WCAG 2.2</a>
            <a asp-controller="Home" asp-action="Pricing">Fiyatlandırma</a>
            <a asp-controller="Home" asp-action="TestSite">Sitenizi Test Edin</a>
            <a asp-controller="Home" asp-action="Docs">Belgeler</a>
        </div>

        <div class="ea-navbar__actions">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Dashboard" asp-action="Index" class="ea-btn ea-btn-ghost">Panel</a>
                <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="ea-btn ea-btn-primary">Çıkış</button>
                </form>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="ea-btn ea-btn-ghost">Giriş Yap</a>
                <a asp-controller="Account" asp-action="Register" class="ea-btn ea-btn-brand">Ücretsiz Başla · 14 gün</a>
            }
        </div>
    </nav>

    <!-- Sayfa içeriği -->
    <main id="main-content">
        @RenderBody()
    </main>

    <footer class="ea-footer">
        &copy; 2026 Eascess, web erişilebilirliği platformu
    </footer>

    <script src="~/js/site.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
