@model IEnumerable<Eascess.Models.DomainListItemViewModel>
@{
    ViewData["Title"] = "Panel";
    var domainList = Model.ToList();
}

<div class="container mt-4">

    <div class="mb-4">
        <h2 class="mb-1">Hoş geldiniz</h2>
        <p class="text-muted">Eascess erişilebilirlik panelinize hoş geldiniz.</p>
    </div>

    <!-- Özet kartlar -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-3">
                        <div class="fs-2">🌐</div>
                        <div>
                            <div class="fs-4 fw-bold">@domainList.Count</div>
                            <div class="text-muted small">Kayıtlı Site</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-3">
                        <div class="fs-2">✅</div>
                        <div>
                            <div class="fs-4 fw-bold">@domainList.Count(d => d.IsVerified)</div>
                            <div class="text-muted small">Aktif Widget</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-3">
                        <div class="fs-2">📊</div>
                        <div>
                            <div class="fs-4 fw-bold">0</div>
                            <div class="text-muted small">Tarama Raporu</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Son siteler -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-0 pt-4 pb-0 px-4">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Web Sitelerim</h5>
                <a asp-controller="Domains" asp-action="Add" class="btn btn-primary btn-sm">+ Site Ekle</a>
            </div>
        </div>
        <div class="card-body p-4">
            @if (!domainList.Any())
            {
                <div class="text-center py-4">
                    <div class="fs-1">🌐</div>
                    <p class="text-muted mt-2 mb-3">Henüz site eklenmedi.</p>
                    <a asp-controller="Domains" asp-action="Add" class="btn btn-primary">İlk Siteyi Ekle</a>
                </div>
            }
            else
            {
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Domain</th>
                            <th>Durum</th>
                            <th>Eklenme</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in domainList)
                        {
                            <tr>
                                <td class="fw-semibold align-middle">@d.DomainUrl</td>
                                <td class="align-middle">
                                    @if (d.IsVerified)
                                    {
                                        <span class="badge bg-success">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Script Bekleniyor</span>
                                    }
                                </td>
                                <td class="text-muted align-middle">
                                    @d.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")
                                </td>
                                <td class="text-end align-middle">
                                    <a asp-controller="Domains" asp-action="Script" asp-route-id="@d.Id"
                                       class="btn btn-outline-primary btn-sm">&lt;/&gt; Script</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="mt-3">
                    <a asp-controller="Domains" asp-action="Index" class="text-muted small">
                        Tüm siteleri gör →
                    </a>
                </div>
            }
        </div>
    </div>

</div>
