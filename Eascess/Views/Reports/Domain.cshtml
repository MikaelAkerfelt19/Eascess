@using Eascess_Application.DTOs
@model IEnumerable<ScanReportListItemDto>
@{
    ViewData["Title"] = "Tarama Raporları";
    var domainId = (int)ViewBag.DomainId;
    var list = Model.ToList();
    var domainUrl = list.FirstOrDefault()?.DomainUrl ?? "";
}

<div class="ea-page">

    <div class="ea-breadcrumb">
        <a asp-controller="Domains" asp-action="Index">Web Sitelerim</a>
        <span class="ea-breadcrumb__sep">/</span>
        @if (domainUrl != "")
        {
            <span class="ea-breadcrumb__current">@domainUrl — Raporlar</span>
        }
        else
        {
            <span class="ea-breadcrumb__current">Raporlar</span>
        }
    </div>

    <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:1rem;margin-bottom:2rem;">
        <div>
            <h2 style="font-size:1.5rem;font-weight:700;margin:0 0 .3rem;color:#fff;">
                @(domainUrl != "" ? domainUrl : "Tarama Raporları")
            </h2>
            <p style="margin:0;color:var(--ea-muted);font-size:.875rem;">WCAG 2.2 erişilebilirlik tarama geçmişi</p>
        </div>
        <form asp-controller="Scan" asp-action="Start" asp-route-id="@domainId" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="ea-btn ea-btn--primary"
                    onclick="this.disabled=true;this.textContent='Taranıyor…';this.form.submit();">
                🔍 Şimdi Tara
            </button>
        </form>
    </div>

    @if (TempData["ScanError"] is string errMsg)
    {
        <div class="ea-alert ea-alert--danger" style="margin-bottom:1.25rem;">⚠ @errMsg</div>
    }
    @if (TempData["ScanSuccess"] is string okMsg)
    {
        <div class="ea-alert ea-alert--success" style="margin-bottom:1.25rem;">✓ @okMsg</div>
    }

    @if (!list.Any())
    {
        <div class="ea-card">
            <div class="ea-empty">
                <div class="ea-empty__icon">📊</div>
                <p class="ea-empty__title">Bu site için henüz tarama raporu yok</p>
                <p class="ea-empty__desc">Widget sitenize kurulduktan sonra otomatik taramalar başlayacak.</p>
            </div>
        </div>
    }
    else
    {
        var avg = (int)list.Average(r => r.WcagScore);
        var avgClass = avg >= 80 ? "ea-score--high" : avg >= 50 ? "ea-score--mid" : "ea-score--low";

        <!-- Stats -->
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:1rem;margin-bottom:2rem;">
            <div class="ea-card">
                <div class="ea-stat">
                    <div class="ea-stat__icon ea-stat__icon--sky">📋</div>
                    <div>
                        <div class="ea-stat__value">@list.Count</div>
                        <div class="ea-stat__label">Toplam Tarama</div>
                    </div>
                </div>
            </div>
            <div class="ea-card">
                <div class="ea-stat">
                    <div class="ea-stat__icon ea-stat__icon--indigo">⭐</div>
                    <div>
                        <div class="ea-stat__value ea-score @avgClass">@avg</div>
                        <div class="ea-stat__label">Ort. WCAG Skoru</div>
                    </div>
                </div>
            </div>
            <div class="ea-card">
                <div class="ea-stat">
                    <div class="ea-stat__icon ea-stat__icon--purple">⚠️</div>
                    <div>
                        <div class="ea-stat__value" style="color:#f87171;">@list.Sum(r => r.ErrorCount)</div>
                        <div class="ea-stat__label">Toplam Hata</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="ea-card">
            <table class="ea-table">
                <thead>
                    <tr>
                        <th>Tarama Tarihi</th>
                        <th>Tür</th>
                        <th>WCAG Skoru</th>
                        <th>Hata Sayısı</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in list)
                    {
                        var sc = r.WcagScore >= 80 ? "ea-score--high" : r.WcagScore >= 50 ? "ea-score--mid" : "ea-score--low";
                        <tr>
                            <td style="color:var(--ea-muted);font-size:.82rem;">@r.ScanDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                            <td><span class="ea-badge ea-badge--muted">@r.ScanType</span></td>
                            <td>
                                <span class="ea-score @sc">@r.WcagScore<span style="font-size:.7rem;font-weight:400;opacity:.6;">/100</span></span>
                            </td>
                            <td>
                                @if (r.ErrorCount > 0)
                                {
                                    <span style="color:#f87171;font-weight:600;">@r.ErrorCount hata</span>
                                }
                                else
                                {
                                    <span style="color:#4ade80;">Hata yok</span>
                                }
                            </td>
                            <td style="text-align:right;">
                                <a asp-controller="Reports" asp-action="Detail" asp-route-id="@r.Id"
                                   class="ea-btn ea-btn--ghost ea-btn--sm">Detay →</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

</div>
