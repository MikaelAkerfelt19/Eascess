@model IEnumerable<Eascess.Models.DomainListItemViewModel>
@{
    ViewData["Title"] = "Web Sitelerim";
}

<div class="ea-page">

    <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:2rem;flex-wrap:wrap;gap:1rem;">
        <div>
            <h2 style="font-size:1.5rem;font-weight:700;margin:0 0 .3rem;color:#fff;">Web Sitelerim</h2>
            <p style="margin:0;color:var(--ea-muted);font-size:.875rem;">Sisteme kayıtlı domainleriniz ve entegrasyon scriptleri</p>
        </div>
        <a asp-action="Add" class="ea-btn ea-btn--primary">+ Yeni Site Ekle</a>
    </div>

    @if (TempData["Success"] is string successMsg)
    {
        <div class="ea-alert ea-alert--success" style="margin-bottom:1.25rem;">
            ✓ @successMsg
        </div>
    }

    @if (!Model.Any())
    {
        <div class="ea-card">
            <div class="ea-empty">
                <div class="ea-empty__icon">🌐</div>
                <p class="ea-empty__title">Henüz site eklemediniz</p>
                <p class="ea-empty__desc">İlk web sitenizi ekleyerek erişilebilirlik entegrasyonuna başlayın.</p>
                <a asp-action="Add" class="ea-btn ea-btn--primary">İlk Siteyi Ekle</a>
            </div>
        </div>
    }
    else
    {
        <div style="display:flex;flex-direction:column;gap:.75rem;">
            @foreach (var domain in Model)
            {
                <div class="ea-card ea-domain-card">
                    <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:1rem;">
                        <div>
                            <div style="display:flex;align-items:center;gap:.6rem;margin-bottom:.4rem;">
                                <span style="font-size:.95rem;font-weight:600;color:#fff;">@domain.DomainUrl</span>
                                @if (domain.IsVerified)
                                {
                                    <span class="ea-badge ea-badge--success">Doğrulandı</span>
                                }
                                else
                                {
                                    <span class="ea-badge ea-badge--warning">Script Bekleniyor</span>
                                }
                            </div>
                            <p style="margin:0;font-size:.78rem;color:var(--ea-muted);">
                                Eklenme: @domain.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                &nbsp;·&nbsp;
                                Key: <code>@domain.LicenseKey.ToString()[..8]…</code>
                            </p>
                        </div>

                        <div style="display:flex;gap:.4rem;flex-wrap:wrap;">
                            <a asp-action="Script" asp-route-id="@domain.Id" class="ea-btn ea-btn--ghost ea-btn--sm">&lt;/&gt; Script Al</a>
                            <a asp-controller="Reports" asp-action="Domain" asp-route-id="@domain.Id" class="ea-btn ea-btn--ghost ea-btn--sm">📊 Raporlar</a>
                            <form asp-action="Delete" asp-route-id="@domain.Id" method="post"
                                  onsubmit="return confirm('@domain.DomainUrl adresini silmek istediğinize emin misiniz?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="ea-btn ea-btn--danger ea-btn--sm">Sil</button>
                            </form>
                        </div>
                    </div>

                    <!-- Script önizleme -->
                    <div style="margin-top:1rem;padding-top:1rem;border-top:1px solid var(--ea-border);">
                        <p style="font-size:.72rem;font-weight:500;color:var(--ea-muted);margin:0 0 .4rem;letter-spacing:.3px;text-transform:uppercase;">Entegrasyon Scripti</p>
                        <div style="display:flex;gap:.5rem;align-items:stretch;">
                            <div class="ea-code-block" style="flex:1;padding:.6rem 1rem;font-size:.78rem;">
                                <code id="script-@domain.Id" style="background:none;padding:0;color:#a5f3fc;">@domain.ScriptTag</code>
                            </div>
                            <button class="ea-btn ea-btn--ghost ea-btn--sm"
                                    onclick="copyScript('script-@domain.Id', this)" type="button"
                                    style="flex-shrink:0;">
                                Kopyala
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

</div>

@section Scripts {
    <script>
        function copyScript(id, btn) {
            const text = document.getElementById(id).textContent;
            navigator.clipboard.writeText(text).then(() => {
                const orig = btn.textContent;
                btn.textContent = 'Kopyalandı ✓';
                btn.style.color = '#4ade80';
                btn.style.borderColor = 'rgba(74,222,128,.3)';
                setTimeout(() => {
                    btn.textContent = orig;
                    btn.style.color = '';
                    btn.style.borderColor = '';
                }, 2000);
            });
        }
    </script>
}
