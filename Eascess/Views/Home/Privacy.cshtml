@{
    ViewData["Title"] = "Gizlilik Politikası";
}

<section style="padding:60px 56px;max-width:820px;margin:0 auto">
    <h1 style="font-family:var(--font-display);font-size:42px;font-weight:400;letter-spacing:-0.02em;margin:0 0 24px">Gizlilik Politikası</h1>
    <p style="font-size:15px;color:var(--ink-600);line-height:1.7;margin:0 0 20px">
        Eascess olarak kullanıcı gizliliğini ciddiye alıyoruz. Bu politika, hizmetimizi kullanırken hangi verileri topladığımızı ve nasıl kullandığımızı açıklar.
    </p>

    <h2 style="font-size:22px;font-weight:600;color:var(--ink-900);margin:32px 0 12px">Toplanan Veriler</h2>
    <p style="font-size:15px;color:var(--ink-600);line-height:1.7;margin:0 0 20px">
        Hesap oluştururken ad, e-posta adresi ve şifre bilgilerinizi alıyoruz. Panel üzerinden eklediğiniz domain adresleri ve erişilebilirlik tarama sonuçları depolanır.
        Ziyaretçi sitelerinde kullanıcı verisi toplanmaz; widget yalnızca görünüm tercihlerini kullanıcının kendi tarayıcısında (localStorage) saklar.
    </p>

    <h2 style="font-size:22px;font-weight:600;color:var(--ink-900);margin:32px 0 12px">AI Görsel Analizi</h2>
    <p style="font-size:15px;color:var(--ink-600);line-height:1.7;margin:0 0 20px">
        Yapay zeka alt metin özelliği etkinleştirildiğinde, yalnızca görsel URL'leri Google Gemini API'sine iletilir. Görsel içerikler Eascess sunucularında depolanmaz.
    </p>

    <h2 style="font-size:22px;font-weight:600;color:var(--ink-900);margin:32px 0 12px">İletişim</h2>
    <p style="font-size:15px;color:var(--ink-600);line-height:1.7;margin:0">
        Gizlilik politikamıza ilişkin sorularınız için <a href="mailto:hello@eascess.io" style="color:var(--indigo-700)">hello@eascess.io</a> adresine yazabilirsiniz.
    </p>
</section>
