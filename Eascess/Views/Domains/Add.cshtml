@model Eascess.Models.AddDomainViewModel
@{
    ViewData["Title"] = "Yeni Site Ekle";
}

<div class="ea-page ea-page--narrow">

    <div class="ea-breadcrumb">
        <a asp-action="Index">Web Sitelerim</a>
        <span class="ea-breadcrumb__sep">/</span>
        <span class="ea-breadcrumb__current">Yeni Site Ekle</span>
    </div>

    <div class="ea-card" style="padding:2rem;">
        <h4 style="font-size:1.2rem;font-weight:700;color:#fff;margin:0 0 .4rem;">Yeni Site Ekle</h4>
        <p style="font-size:.83rem;color:var(--ea-muted);margin:0 0 2rem;line-height:1.6;">
            Sitenizi ekledikten sonra size özel bir entegrasyon scripti oluşturulur.
            Bu scripti sitenizin <code>&lt;head&gt;</code> etiketleri arasına yapıştırın.
        </p>

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
        {
            <div class="ea-alert ea-alert--danger">
                <div asp-validation-summary="All"></div>
            </div>
        }

        <form asp-action="Add" method="post" novalidate>
            @Html.AntiForgeryToken()

            <div style="margin-bottom:1.5rem;">
                <label asp-for="DomainUrl" class="ea-label">Domain Adresi</label>
                <input asp-for="DomainUrl"
                       class="ea-input"
                       placeholder="example.com"
                       autocomplete="off"
                       autofocus />
                <span asp-validation-for="DomainUrl" class="ea-error"></span>
                <p class="ea-form-hint">Protokol (https://) olmadan da girebilirsiniz. Örn: <strong style="color:rgba(255,255,255,.6)">mysite.com</strong></p>
            </div>

            <div style="display:flex;gap:.6rem;">
                <button type="submit" class="ea-btn ea-btn--primary">Site Ekle</button>
                <a asp-action="Index" class="ea-btn ea-btn--ghost">İptal</a>
            </div>
        </form>
    </div>

    <!-- Nasıl Çalışır -->
    <div class="ea-card" style="padding:1.5rem;margin-top:.75rem;">
        <p style="font-size:.83rem;font-weight:600;color:#fff;margin:0 0 .85rem;">Nasıl Çalışır?</p>
        <ol style="margin:0;padding-left:1.2rem;display:flex;flex-direction:column;gap:.6rem;">
            <li style="font-size:.82rem;color:var(--ea-muted);">Sitenizi buraya ekleyin</li>
            <li style="font-size:.82rem;color:var(--ea-muted);">Size özel <code>&lt;script&gt;</code> etiketini kopyalayın</li>
            <li style="font-size:.82rem;color:var(--ea-muted);">Etiketi sitenizin <code>&lt;head&gt;</code> bölümüne yapıştırın</li>
            <li style="font-size:.82rem;color:var(--ea-muted);">Eascess widget'ı otomatik olarak sitenizde belirir</li>
        </ol>
    </div>

</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
