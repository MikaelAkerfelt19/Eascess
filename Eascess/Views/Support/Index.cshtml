@using Eascess_Domain.Entities
@model IList<SupportTicket>
@{
    ViewData["Title"] = "Destek Talepleri";
    ViewData["Active"] = "support";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}

@{
    var hasPriority = ViewBag.HasPrioritySupport is true;
}

<!-- Topbar -->
<div class="ea-topbar">
    <div>
        <div class="ea-topbar-eyebrow">Yardım &amp; Destek</div>
        <h1 class="ea-topbar-title" style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
            Destek Talepleri
            @if (hasPriority)
            {
                @* Ultra ve Kurumsal: öncelik hafif parlayan bir rozetle belirtilir *@
                <span class="ea-priority-badge">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M13 2L3 14h8l-1 8 10-12h-8z"/>
                    </svg>
                    Öncelikli Destek
                </span>
            }
        </h1>
    </div>
    <a asp-action="Create" class="ea-btn ea-btn-brand">+ Yeni Talep</a>
</div>

@if (TempData["Success"] is string msg)
{
    <div class="ea-alert ea-alert--success">✓ @msg</div>
}

@if (hasPriority)
{
    <div class="ea-card ea-priority-panel" style="padding:16px 20px;display:flex;gap:12px;align-items:flex-start">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="var(--indigo-700)" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;margin-top:1px" aria-hidden="true">
            <path d="M13 2L3 14h8l-1 8 10-12h-8z"/>
        </svg>
        <div style="font-size:var(--fs-sm);color:var(--ink-700)">
            <strong style="color:var(--ink-900)">@ViewBag.PlanName planındasınız.</strong>
            Talepleriniz destek sırasında öne alınır ve standart taleplerden önce yanıtlanır.
        </div>
    </div>
}

@if (!Model.Any())
{
    <div class="ea-card" style="padding:40px;text-align:center">
        <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="var(--ink-300)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin:0 auto 12px;display:block">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
        </svg>
        <p style="color:var(--ink-500);margin:0 0 16px">Henüz destek talebiniz yok.</p>
        <a asp-action="Create" class="ea-btn ea-btn-brand">İlk Talebinizi Oluşturun</a>
    </div>
}
else
{
    <div class="ea-card" style="overflow:hidden">
        <table style="width:100%;border-collapse:collapse">
            <thead>
                <tr style="border-bottom:1px solid var(--cream-300)">
                    <th style="padding:12px 16px;text-align:left;font-size:var(--fs-xs);font-weight:600;text-transform:uppercase;letter-spacing:.05em;color:var(--ink-500)">#</th>
                    <th style="padding:12px 16px;text-align:left;font-size:var(--fs-xs);font-weight:600;text-transform:uppercase;letter-spacing:.05em;color:var(--ink-500)">Konu</th>
                    <th style="padding:12px 16px;text-align:left;font-size:var(--fs-xs);font-weight:600;text-transform:uppercase;letter-spacing:.05em;color:var(--ink-500)">Durum</th>
                    <th style="padding:12px 16px;text-align:left;font-size:var(--fs-xs);font-weight:600;text-transform:uppercase;letter-spacing:.05em;color:var(--ink-500)">Tarih</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model)
                {
                    <tr style="border-bottom:1px solid var(--cream-200)">
                        <td style="padding:12px 16px;font-size:var(--fs-sm);color:var(--ink-500)">#@t.Id</td>
                        <td style="padding:12px 16px;font-size:var(--fs-sm);font-weight:500;color:var(--ink-900)">@t.Subject</td>
                        <td style="padding:12px 16px">
                            @{
                                var (bg, fg) = t.Status switch
                                {
                                    "Open"     => ("oklch(95% 0.04 145)", "oklch(30% 0.08 145)"),
                                    "Resolved" => ("oklch(95% 0.02 260)", "oklch(30% 0.06 260)"),
                                    _          => ("var(--cream-200)", "var(--ink-600)"),
                                };
                                var label = t.Status switch
                                {
                                    "Open"     => "Açık",
                                    "Resolved" => "Çözüldü",
                                    _          => t.Status,
                                };
                            }
                            <span style="display:inline-block;padding:2px 12px;border-radius:20px;font-size:var(--fs-xs);font-weight:600;background:@bg;color:@fg">@label</span>
                        </td>
                        <td style="padding:12px 16px;font-size:var(--fs-sm);color:var(--ink-500)">@t.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
