@using Eascess_Application.DTOs
@model IEnumerable<ScanReportListItemDto>
@{
    ViewData["Title"] = "Raporlar";
    ViewData["Active"] = "reports";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
    var domainId = (int)ViewBag.DomainId;
    var list = Model.ToList();
    var domainUrl = list.FirstOrDefault()?.DomainUrl ?? "";
}

<!-- Topbar -->
<div class="ea-topbar">
    <div>
        <div class="ea-topbar-eyebrow">
            <a asp-controller="Reports" asp-action="Index" style="color:var(--ink-500)">Raporlar</a> / @(domainUrl != "" ? domainUrl : "Domain")
        </div>
        <h1 class="ea-topbar-title">@(domainUrl != "" ? domainUrl : "Tarama Raporları")</h1>
    </div>
    <div class="ea-topbar-actions">
        <a asp-controller="Reports" asp-action="Analytics" asp-route-id="@domainId"
           class="ea-btn" style="background:var(--cream-100);color:var(--ink-700);border:1px solid var(--cream-300)">
            <svg viewBox="0 0 24 24" fill="currentColor" style="width:16px;height:16px"><path d="M3 3v18h18v-2H5V3H3zm4 14h2V9H7v8zm4 0h2V5h-2v12zm4 0h2v-6h-2v6z"/></svg>
            Analitikler
        </a>
        <form asp-controller="Scan" asp-action="Start" asp-route-id="@domainId" method="post"
              onsubmit="var b=this.querySelector('button');if(b.disabled)return false;b.disabled=true;b.textContent='Taranıyor…';">
            @Html.AntiForgeryToken()
            <button type="submit" class="ea-btn ea-btn-brand">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                Şimdi Tara
            </button>
        </form>
    </div>
</div>

@if (TempData["ScanError"] is string errMsg)
{
    <div class="ea-alert ea-alert--danger">@errMsg</div>
}
@if (TempData["ScanSuccess"] is string okMsg)
{
    <div class="ea-alert ea-alert--success">@okMsg</div>
}

@if (!list.Any())
{
    <div class="ea-card">
        <div class="ea-empty">
            <div class="ea-empty__icon">📊</div>
            <p class="ea-empty__title">Bu domain için henüz rapor yok</p>
            <p class="ea-empty__desc">İlk erişilebilirlik denetimini başlatmak için "Şimdi Tara" butonuna tıklayın.</p>
        </div>
    </div>
}
else
{
    var avg = (int)list.Average(r => r.WcagScore);

    <!-- İstatistikler -->
    <div class="ea-stats" style="grid-template-columns:repeat(3,1fr);margin-bottom:20px">
        <div class="ea-stat">
            <div class="ea-stat-label">Toplam Tarama</div>
            <div class="ea-stat-value">@list.Count</div>
            <div class="ea-stat-accent"></div>
        </div>
        <div class="ea-stat">
            <div class="ea-stat-label">Ort. WCAG Skoru</div>
            <div class="ea-stat-value @(avg >= 80 ? "ea-score--high" : avg >= 50 ? "ea-score--mid" : "ea-score--low")">@avg</div>
            <div class="ea-stat-accent"></div>
        </div>
        <div class="ea-stat">
            <div class="ea-stat-label">Toplam Hata</div>
            <div class="ea-stat-value" style="color:var(--danger)">@list.Sum(r => r.ErrorCount)</div>
            <div class="ea-stat-accent"></div>
        </div>
    </div>

    <div class="ea-card" style="padding:0;overflow:hidden">
        <table class="ea-table">
            <thead>
                <tr>
                    <th>Tarama Tarihi</th>
                    <th>Tür</th>
                    <th>WCAG Skoru</th>
                    <th>Hata Sayısı</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in list)
                {
                    var sc = r.WcagScore >= 80 ? "ea-score--high" : r.WcagScore >= 50 ? "ea-score--mid" : "ea-score--low";
                    <tr>
                        <td style="color:var(--ink-600);font-size:13px">@r.ScanDate.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td>
                        <td><span class="ea-badge ea-badge-neutral">@r.ScanType</span></td>
                        <td>
                            <span class="ea-score @sc">@r.WcagScore<span style="font-size:11px;font-weight:400;opacity:.6">/100</span></span>
                        </td>
                        <td>
                            @if (r.ErrorCount > 0)
                            {
                                <span style="color:var(--danger);font-weight:600">@r.ErrorCount hata</span>
                            }
                            else
                            {
                                <span style="color:var(--success)">Hata yok</span>
                            }
                        </td>
                        <td style="text-align:right">
                            <a asp-controller="Reports" asp-action="Detail" asp-route-id="@r.Id"
                               class="ea-btn ea-btn-ghost" style="padding:6px 10px;min-height:32px;font-size:12px">Detay</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
