@using Eascess_Application.DTOs
@model IEnumerable<ScanReportListItemDto>
@{
    ViewData["Title"] = "Tarama Raporları";
    ViewData["Active"] = "reports";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
    var list = Model.ToList();
    var avg = list.Any() ? (int)list.Average(r => r.WcagScore) : 0;
}

<!-- Topbar -->
<div class="ea-topbar">
    <div>
        <div class="ea-topbar-eyebrow">Genel Bakış</div>
        <h1 class="ea-topbar-title">Tarama Raporları</h1>
    </div>
</div>

@if (!list.Any())
{
    <div class="ea-card">
        <div class="ea-empty">
            <div class="ea-empty__icon">📊</div>
            <p class="ea-empty__title">Henüz tarama raporu yok</p>
            <p class="ea-empty__desc">Domainlerinize gidin ve erişilebilirlik sonuçlarını görmek için bir tarama başlatın.</p>
            <a asp-controller="Domains" asp-action="Index" class="ea-btn ea-btn-brand">Domainleri Yönet</a>
        </div>
    </div>
}
else
{
    <!-- İstatistikler -->
    <div class="ea-stats" style="grid-template-columns:repeat(4,1fr)">
        <div class="ea-stat">
            <div class="ea-stat-label">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 20h18M7 16V9M12 16V4M17 16v-7"/></svg>
                Toplam Tarama
            </div>
            <div class="ea-stat-value">@list.Count</div>
            <div class="ea-stat-delta">Tüm zamanlar</div>
            <div class="ea-stat-accent"></div>
        </div>
        <div class="ea-stat">
            <div class="ea-stat-label">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                Ort. WCAG Skoru
            </div>
            <div class="ea-stat-value @(avg >= 80 ? "ea-score--high" : avg >= 50 ? "ea-score--mid" : "ea-score--low")">@avg</div>
            <div class="ea-stat-delta">100 üzerinden</div>
            <div class="ea-stat-accent"></div>
        </div>
        <div class="ea-stat">
            <div class="ea-stat-label">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0zM12 9v4M12 17h.01"/></svg>
                Toplam Hata
            </div>
            <div class="ea-stat-value" style="color:var(--danger)">@list.Sum(r => r.ErrorCount)</div>
            <div class="ea-stat-delta">Tüm taramalarda</div>
            <div class="ea-stat-accent"></div>
        </div>
        <div class="ea-stat">
            <div class="ea-stat-label">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 3 2.5 15 0 18M12 3c-2.5 3-2.5 15 0 18"/></svg>
                Taranan Site
            </div>
            <div class="ea-stat-value">@list.Select(r => r.DomainId).Distinct().Count()</div>
            <div class="ea-stat-delta">Benzersiz domain</div>
            <div class="ea-stat-accent"></div>
        </div>
    </div>

    <!-- Tablo -->
    <div class="ea-card" style="padding:0;overflow:hidden">
        <table class="ea-table">
            <thead>
                <tr>
                    <th>Domain</th>
                    <th>Tarih</th>
                    <th>Tür</th>
                    <th>WCAG Skoru</th>
                    <th>Hata</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in list)
                {
                    var sc = r.WcagScore >= 80 ? "ea-score--high" : r.WcagScore >= 50 ? "ea-score--mid" : "ea-score--low";
                    <tr>
                        <td>
                            <a asp-controller="Reports" asp-action="Domain" asp-route-id="@r.DomainId"
                               style="font-weight:600;color:var(--ink-900)">
                                @r.DomainUrl
                            </a>
                        </td>
                        <td style="color:var(--ink-500);font-size:13px">@r.ScanDate.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td>
                        <td><span class="ea-badge ea-badge-neutral">@r.ScanType</span></td>
                        <td>
                            <span class="ea-score @sc">@r.WcagScore<span style="font-size:11px;font-weight:400;opacity:.6">/100</span></span>
                        </td>
                        <td>
                            @if (r.ErrorCount > 0)
                            {
                                <span style="color:var(--danger);font-weight:600">@r.ErrorCount</span>
                            }
                            else
                            {
                                <span style="color:var(--success)">0</span>
                            }
                        </td>
                        <td style="text-align:right">
                            <a asp-controller="Reports" asp-action="Detail" asp-route-id="@r.Id"
                               class="ea-btn ea-btn-ghost" style="padding:6px 10px;min-height:32px;font-size:12px">Detay</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
