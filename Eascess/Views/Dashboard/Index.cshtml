@model IEnumerable<Eascess.Models.DomainListItemViewModel>
@{
    ViewData["Title"] = "Panel";
    ViewData["Active"] = "dashboard";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
    var domainList = Model.ToList();
    var verifiedCount = domainList.Count(d => d.IsVerified);
    var pendingCount  = domainList.Count(d => !d.IsVerified);
    var hour = DateTime.Now.Hour;
    var greeting = hour < 12 ? "Günaydın" : hour < 18 ? "İyi günler" : "İyi akşamlar";
}

<!-- Topbar -->
<div class="ea-topbar">
    <div>
        <div class="ea-topbar-eyebrow">Genel Bakış · son 30 gün</div>
        <h1 class="ea-topbar-title">@greeting</h1>
    </div>
    <div class="ea-topbar-actions">
        <a asp-controller="Domains" asp-action="Add" class="ea-btn ea-btn-brand">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
            Domain Ekle
        </a>
    </div>
</div>

@if (ViewBag.TrialDaysLeft is int trialDays)
{
    var urgency = trialDays <= 3 ? "background:oklch(95% 0.06 25);border:1px solid oklch(80% 0.1 25)" : "background:oklch(96% 0.04 145);border:1px solid oklch(82% 0.1 145)";
    var color   = trialDays <= 3 ? "var(--danger,#dc2626)" : "oklch(30% 0.12 145)";
    <div style="@urgency;border-radius:var(--r-md);padding:14px 20px;display:flex;align-items:center;gap:12px;margin-bottom:0">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="@color" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0">
            <circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/>
        </svg>
        <span style="font-size:14px;color:@color;flex:1">
            <strong>14 Günlük Ücretsiz Denemeniz</strong> — Bitimine <strong>@trialDays gün</strong> kaldı. Pro özellikler aktif.
        </span>
        <a asp-controller="Home" asp-action="Pricing" style="font-size:13px;font-weight:600;color:@color;text-decoration:none;white-space:nowrap">Pro'ya Geç →</a>
    </div>
}

<!-- İstatistik kartları -->
<div class="ea-stats">
    <div class="ea-stat">
        <div class="ea-stat-label">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            Erişilebilirlik Skoru
        </div>
        <div class="ea-stat-value">—</div>
        <div class="ea-stat-delta">Skor görmek için tarama yapın</div>
        <div class="ea-stat-accent"></div>
    </div>
    <div class="ea-stat">
        <div class="ea-stat-label">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 3 2.5 15 0 18M12 3c-2.5 3-2.5 15 0 18"/></svg>
            Aktif Domainler
        </div>
        <div class="ea-stat-value">@domainList.Count</div>
        <div class="ea-stat-delta">@verifiedCount doğrulandı · @pendingCount bekliyor</div>
        <div class="ea-stat-accent"></div>
    </div>
    <div class="ea-stat">
        <div class="ea-stat-label">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 20h18M7 16V9M12 16V4M17 16v-7"/></svg>
            Tarama Raporları
        </div>
        <div class="ea-stat-value">@ViewBag.TotalReportCount</div>
        <div class="ea-stat-delta">Toplam denetim sayısı</div>
        <div class="ea-stat-accent"></div>
    </div>
    <div class="ea-stat">
        <div class="ea-stat-label">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0zM12 9v4M12 17h.01"/></svg>
            Açık Sorunlar
        </div>
        <div class="ea-stat-value">—</div>
        <div class="ea-stat-delta">Sorun bulmak için tarama yapın</div>
        <div class="ea-stat-accent"></div>
    </div>
</div>

<!-- Plan bilgi kartı -->
@{
    var aiUsed    = (int)(ViewBag.AiUsedThisMonth ?? 0);
    var aiQuota   = (int)(ViewBag.MonthlyAiQuota ?? 50);
    var aiPct     = aiQuota > 0 ? Math.Min(100, (int)Math.Round(aiUsed * 100.0 / aiQuota)) : 0;
    var domCount  = (int)(ViewBag.DomainCount ?? 0);
    var maxDom    = (int)(ViewBag.MaxDomains ?? 1);
    var planName  = (string)(ViewBag.PlanName ?? "Ücretsiz");
    var isPro     = planName != "Ücretsiz";
}
<div class="ea-card" style="padding:20px 24px;display:flex;align-items:center;gap:32px;flex-wrap:wrap;margin-bottom:0">
    <div style="display:flex;align-items:center;gap:10px">
        <div style="background:@(isPro ? "var(--indigo-700)" : "var(--cream-200)");color:@(isPro ? "white" : "var(--ink-700)");padding:4px 14px;border-radius:999px;font-size:12px;font-weight:700">
            @planName
        </div>
        @if (!isPro)
        {
            <a asp-controller="Home" asp-action="Pricing" style="font-size:13px;color:var(--indigo-700);font-weight:600;text-decoration:none">Planı yükselt →</a>
        }
    </div>
    <div style="display:flex;align-items:center;gap:6px;flex:1;min-width:200px">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="var(--ink-500)" stroke-width="2" stroke-linecap="round"><path d="M12 2l1.5 5.5L19 9l-5.5 1.5L12 16l-1.5-5.5L5 9l5.5-1.5z"/></svg>
        <span style="font-size:13px;color:var(--ink-600)">YZ Tarama</span>
        <div style="flex:1;height:6px;background:var(--cream-300);border-radius:999px;overflow:hidden;max-width:160px">
            <div style="height:100%;width:@aiPct%;background:@(aiPct >= 90 ? "var(--danger)" : aiPct >= 70 ? "var(--warning)" : "var(--indigo-700)");border-radius:999px;transition:width .3s"></div>
        </div>
        <span style="font-size:12px;color:var(--ink-500)">@aiUsed / @aiQuota</span>
    </div>
    <div style="display:flex;align-items:center;gap:6px">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="var(--ink-500)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 3 2.5 15 0 18"/></svg>
        <span style="font-size:13px;color:var(--ink-600)">Domain</span>
        <span style="font-size:13px;font-weight:600;color:var(--ink-900)">@domCount / @maxDom</span>
    </div>
</div>

<!-- Domain tablosu + AI Denetçi kartı -->
<div style="display:grid;grid-template-columns:1.7fr 1fr;gap:18px">

    <!-- Domain tablosu -->
    <div class="ea-card" style="padding:0;overflow:hidden">
        <div style="padding:18px 20px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--cream-300)">
            <div>
                <div class="ea-card-title">Domainleriniz</div>
                <div class="ea-card-sub">Lisans anahtarları, doğrulama ve durum özeti.</div>
            </div>
            <a asp-controller="Domains" asp-action="Index" class="ea-btn ea-btn-ghost" style="padding:8px 12px;min-height:36px;font-size:13px">
                Tümünü Gör
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
            </a>
        </div>

        @if (!domainList.Any())
        {
            <div class="ea-empty">
                <div class="ea-empty__icon">🌐</div>
                <p class="ea-empty__title">Henüz domain yok</p>
                <p class="ea-empty__desc">Başlamak için ilk domaininizi ekleyin.</p>
                <a asp-controller="Domains" asp-action="Add" class="ea-btn ea-btn-brand">Domain Ekle</a>
            </div>
        }
        else
        {
            <table class="ea-table">
                <thead>
                    <tr>
                        <th>Domain</th>
                        <th>Durum</th>
                        <th>Eklenme</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in domainList)
                    {
                        <tr>
                            <td>
                                <div style="display:flex;align-items:center;gap:10px">
                                    <div style="width:30px;height:30px;border-radius:8px;background:var(--cream-200);display:grid;place-items:center;color:var(--ink-600)">
                                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 3 2.5 15 0 18M12 3c-2.5 3-2.5 15 0 18"/></svg>
                                    </div>
                                    <div>
                                        <div style="font-weight:600;color:var(--ink-900)">@d.DomainUrl</div>
                                        <div style="font-size:12px;color:var(--ink-500)">@planName plan</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                @if (d.IsVerified)
                                {
                                    <span class="ea-badge ea-badge-ok">
                                        <span class="ea-badge-dot"></span> Doğrulandı
                                    </span>
                                }
                                else
                                {
                                    <span class="ea-badge ea-badge-wait">
                                        <span class="ea-badge-dot"></span> Script Bekleniyor
                                    </span>
                                }
                            </td>
                            <td style="color:var(--ink-600)">@d.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                            <td style="text-align:right">
                                <div style="display:flex;gap:6px;justify-content:flex-end;flex-wrap:wrap">
                                    <form asp-controller="Scan" asp-action="Start" asp-route-id="@d.Id" method="post" style="display:inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="ea-btn ea-btn-ghost" style="padding:6px 10px;min-height:32px;font-size:12px"
                                                onclick="this.disabled=true;this.textContent='…';this.form.submit();">
                                            Tara
                                        </button>
                                    </form>
                                    <a asp-controller="Reports" asp-action="Domain" asp-route-id="@d.Id"
                                       class="ea-btn ea-btn-ghost" style="padding:6px 10px;min-height:32px;font-size:12px">Raporlar</a>
                                    <a asp-controller="Domains" asp-action="Script" asp-route-id="@d.Id"
                                       class="ea-btn ea-btn-ghost" style="padding:6px 10px;min-height:32px;font-size:12px">Script</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <!-- Widget Hızlı Ayarlar -->
    @{
        var qs = ViewBag.QuickWidgetSettings as Eascess_Application.DTOs.WidgetSettingDto;
    }
    <div class="ea-card" style="padding:0;overflow:hidden;align-self:start">
        <div style="padding:16px 20px;border-bottom:1px solid var(--cream-300);display:flex;justify-content:space-between;align-items:center">
            <div>
                <div class="ea-card-title">Widget Ayarları</div>
                @if (qs != null)
                {
                    <div class="ea-card-sub">@qs.DomainUrl</div>
                }
            </div>
            @if (qs != null)
            {
                <a asp-controller="WidgetSettings" asp-action="Index" asp-route-id="@qs.DomainId"
                   class="ea-btn ea-btn-ghost" style="padding:6px 10px;min-height:32px;font-size:12px">
                    Tam Ayarlar
                    <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
                </a>
            }
        </div>

        @if (qs == null)
        {
            <div class="ea-empty">
                <div class="ea-empty__icon">🎨</div>
                <p class="ea-empty__title">Henüz domain yok</p>
                <p class="ea-empty__desc">Widget ayarlarını görmek için önce bir domain ekleyin.</p>
                <a asp-controller="Domains" asp-action="Add" class="ea-btn ea-btn-brand" style="font-size:13px;min-height:38px;padding:9px 14px">Domain Ekle</a>
            </div>
        }
        else
        {
            <form asp-controller="WidgetSettings" asp-action="Update" method="post" style="padding:18px 20px">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="/Dashboard" />
                <input type="hidden" name="Id" value="@qs.Id" />
                <input type="hidden" name="DomainId" value="@qs.DomainId" />
                <input type="hidden" name="DomainUrl" value="@qs.DomainUrl" />
                <input type="hidden" name="Language" value="@qs.Language" />
                <input type="hidden" name="IsAiEnabled" value="@qs.IsAiEnabled.ToString().ToLower()" />
                <input type="hidden" name="PoweredByVisible" value="@qs.PoweredByVisible.ToString().ToLower()" />
                <input type="hidden" name="LogoUrl" value="@qs.LogoUrl" />
                <input type="hidden" name="WidgetTitle" value="@qs.WidgetTitle" />

                <!-- Tema Rengi -->
                <div style="margin-bottom:16px">
                    <label class="ea-label" style="margin-bottom:8px">Tema Rengi</label>
                    <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
                        <input type="color" id="dash-color-input" name="ThemeColor" value="@qs.ThemeColor"
                               style="width:38px;height:38px;border:1px solid var(--cream-300);border-radius:var(--r-sm);background:white;cursor:pointer;padding:3px" />
                        <input type="text" id="dash-color-text" value="@qs.ThemeColor"
                               class="ea-input" style="width:100px;min-height:38px;padding:8px 10px;font-size:13px"
                               oninput="dashSyncColor(this.value)" placeholder="#38bdf8" />
                        <div style="display:flex;gap:5px;flex-wrap:wrap">
                            @foreach (var c in new[] { "#38bdf8", "#818cf8", "#c084fc", "#22d3ee", "#4ade80", "#fb923c", "#f87171", "#facc15" })
                            {
                                <button type="button" onclick="dashSetColor('@c')"
                                        style="width:20px;height:20px;background:@c;border:2px solid white;border-radius:50%;cursor:pointer;box-shadow:0 0 0 1px var(--cream-300);transition:transform .15s"
                                        onmouseover="this.style.transform='scale(1.2)'" onmouseout="this.style.transform='scale(1)'">
                                </button>
                            }
                        </div>
                    </div>
                </div>

                <!-- Konum -->
                <div style="margin-bottom:16px">
                    <label class="ea-label" style="margin-bottom:8px">Konum</label>
                    <!-- Görsel köşe seçici -->
                    <div style="position:relative;width:140px;height:90px;background:var(--cream-100);border:1px solid var(--cream-300);border-radius:var(--r-sm);overflow:hidden">
                        <div style="position:absolute;inset:6px;border:1px dashed var(--cream-300);border-radius:4px;pointer-events:none"></div>
                        @foreach (var pos in new[] {
                            ("bottom-right", "right:6px;bottom:6px"),
                            ("bottom-left",  "left:6px;bottom:6px"),
                            ("top-right",    "right:6px;top:6px"),
                            ("top-left",     "left:6px;top:6px"),
                        })
                        {
                            var isActive = qs.Position == pos.Item1;
                            <label style="position:absolute;@pos.Item2;cursor:pointer" title="@pos.Item1">
                                <input type="radio" name="Position" value="@pos.Item1"
                                       @(isActive ? "checked" : "")
                                       style="position:absolute;opacity:0;width:0;height:0"
                                       onchange="dashHighlightPos(this)" />
                                <span class="dash-pos-dot" data-pos="@pos.Item1"
                                      style="display:block;width:22px;height:22px;border-radius:50%;border:2px solid @(isActive ? "var(--teal-600)" : "var(--cream-300)");background:@(isActive ? "var(--teal-600)" : "white");transition:all .15s;box-shadow:var(--sh-sm)">
                                </span>
                            </label>
                        }
                    </div>
                    <div id="dash-pos-label" style="font-size:12px;color:var(--ink-500);margin-top:5px">
                        @(qs.Position switch {
                            "bottom-right" => "Sağ Alt",
                            "bottom-left"  => "Sol Alt",
                            "top-right"    => "Sağ Üst",
                            "top-left"     => "Sol Üst",
                            _              => "Sağ Alt"
                        })
                    </div>
                </div>

                <button type="submit" class="ea-btn ea-btn-brand" style="width:100%;justify-content:center;font-size:13px;min-height:40px">
                    Kaydet
                </button>
            </form>
        }
    </div>

</div>

@section Scripts {
<script>
    var dashColorInput = document.getElementById('dash-color-input');
    var dashColorText  = document.getElementById('dash-color-text');

    function dashSyncColor(val) {
        if (/^#[0-9a-fA-F]{6}$/.test(val) && dashColorInput) {
            dashColorInput.value = val;
        }
    }

    function dashSetColor(c) {
        if (!dashColorInput) return;
        dashColorInput.value = c;
        dashColorText.value  = c;
    }

    if (dashColorInput) {
        dashColorInput.addEventListener('input', function () {
            dashColorText.value = dashColorInput.value;
        });
    }

    var posLabels = {
        'bottom-right': 'Sağ Alt',
        'bottom-left':  'Sol Alt',
        'top-right':    'Sağ Üst',
        'top-left':     'Sol Üst',
    };

    function dashHighlightPos(radio) {
        document.querySelectorAll('.dash-pos-dot').forEach(function (dot) {
            var active = dot.dataset.pos === radio.value;
            dot.style.background     = active ? 'var(--teal-600)' : 'white';
            dot.style.borderColor    = active ? 'var(--teal-600)' : 'var(--cream-300)';
        });
        var lbl = document.getElementById('dash-pos-label');
        if (lbl) lbl.textContent = posLabels[radio.value] || radio.value;
    }
</script>
}
