<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Eascess</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

<a href="#ea-main-content" class="ea-skip-link">İçeriğe geç</a>

<div class="ea-app">

    <!-- Yan menü -->
    <aside class="ea-sidebar" aria-label="Uygulama gezinmesi">

        <!-- Marka -->
        <div class="ea-brand">
            <img src="~/image/Eascess_logo.png" alt="Eascess" class="ea-brand-logo" />
            <div>
                <div class="ea-brand-name">Eascess</div>
                <div class="ea-brand-meta">WCAG 2.2 · AAA</div>
            </div>
        </div>

        <!-- Çalışma alanı navigasyonu -->
        <div class="ea-nav-section">Çalışma Alanı</div>

        <a asp-controller="Dashboard" asp-action="Index"
           class="ea-nav-item @(ViewData["Active"]?.ToString() == "dashboard" ? "active" : "")">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/>
                <rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/>
            </svg>
            <span>Panel</span>
        </a>

        <a asp-controller="Domains" asp-action="Index"
           class="ea-nav-item @(ViewData["Active"]?.ToString() == "domains" ? "active" : "")">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 3 2.5 15 0 18M12 3c-2.5 3-2.5 15 0 18"/>
            </svg>
            <span>Domainler</span>
        </a>

        <a asp-controller="Reports" asp-action="Index"
           class="ea-nav-item @(ViewData["Active"]?.ToString() == "reports" ? "active" : "")">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 20h18M7 16V9M12 16V4M17 16v-7"/>
            </svg>
            <span>Tarama Raporları</span>
        </a>

        <a asp-controller="Domains" asp-action="Index"
           class="ea-nav-item @(ViewData["Active"]?.ToString() == "widget" ? "active" : "")">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="8" height="8" rx="1.5"/><rect x="13" y="3" width="8" height="8" rx="4"/>
                <rect x="3" y="13" width="8" height="8" rx="4"/><rect x="13" y="13" width="8" height="8" rx="1.5"/>
            </svg>
            <span>Widget Stüdyo</span>
        </a>

        <a asp-controller="Support" asp-action="Index"
           class="ea-nav-item @(ViewData["Active"]?.ToString() == "support" ? "active" : "")">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
            </svg>
            <span>Destek</span>
        </a>

        <!-- Kaynaklar navigasyonu -->
        <div class="ea-nav-section" style="margin-top:12px">Kaynaklar</div>

        <a asp-controller="Home" asp-action="Docs" target="_blank" class="ea-nav-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 5v14a2 2 0 0 0 2 2h14V3H6a2 2 0 0 0-2 2zM8 3v18"/>
            </svg>
            <span>Belgeler &amp; Kod</span>
        </a>

        <!-- Yan menü alt bilgisi -->
        <div class="ea-sidebar-footer">
            <div class="ea-avatar">
                @{
                    var userName = User.Identity?.Name ?? "K";
                    var initials = userName.Length >= 2 ? userName.Substring(0, 2).ToUpper() : userName.ToUpper();
                }
                @initials
            </div>
            <div style="flex:1;min-width:0">
                <div class="ea-user-name">@(User.Identity?.Name ?? "Kullanıcı")</div>
                <div class="ea-user-meta">@(ViewBag.PlanName ?? "Ücretsiz") plan</div>
            </div>
            <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline">
                @Html.AntiForgeryToken()
                <button type="submit" title="Çıkış yap"
                        style="background:none;border:none;cursor:pointer;padding:4px;color:var(--ink-500);display:flex;align-items:center">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/>
                    </svg>
                </button>
            </form>
        </div>

    </aside>

    <!-- Ana içerik -->
    <main class="ea-main" id="ea-main-content">
        @RenderBody()
    </main>

</div>

<script src="~/js/site.js" asp-append-version="true" defer></script>
@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
