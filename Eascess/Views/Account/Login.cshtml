@model Eascess.Models.LoginViewModel
@{
    ViewData["Title"] = "Giriş Yap";
    ViewData["AuthMode"] = "login";
    Layout = "_AuthLayout";
}

<div class="auth-card">

    <h1 class="auth-heading">Tekrar hoş geldiniz</h1>
    <p class="auth-subheading">Erişilebilirlik panelinize giriş yapın</p>

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
    {
        <div class="alert-danger">
            <div asp-validation-summary="All" class="text-danger"></div>
        </div>
    }

    <form asp-action="Login" asp-controller="Account" method="post" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

        <div class="form-group">
            <label class="form-label" asp-for="Email">E-posta adresi</label>
            <input class="form-control" asp-for="Email" type="email"
                   placeholder="siz@firma.com" autocomplete="email" autofocus />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label class="form-label" asp-for="Password">Şifre</label>
            <input class="form-control" asp-for="Password" type="password"
                   placeholder="••••••••" autocomplete="current-password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="row-between">
            <label class="check-label">
                <input type="checkbox" asp-for="RememberMe" />
                Beni hatırla
            </label>
            @* Support sayfası [Authorize] gerektirir; giriş yapamayan kullanıcı için e-posta yolu sunulur *@
            <a href="mailto:destek@eascess.io?subject=%C5%9Eifre%20s%C4%B1f%C4%B1rlama%20talebi" class="auth-link">Şifremi unuttum?</a>
        </div>

        <button type="submit" class="btn-auth">Giriş Yap</button>
    </form>

    <div class="divider">
        <div class="divider-line"></div>
        <span class="divider-text">Eascess'e yeni misiniz?</span>
        <div class="divider-line"></div>
    </div>

    <p class="auth-footer-text">
        Hesabınız yok mu? <a asp-action="Register" asp-controller="Account">Ücretsiz hesap oluşturun</a>
    </p>

</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
