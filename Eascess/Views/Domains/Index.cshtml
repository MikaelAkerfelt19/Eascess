@model IEnumerable<Eascess.Models.DomainListItemViewModel>
@{
    ViewData["Title"] = "Web Sitelerim";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Web Sitelerim</h2>
            <p class="text-muted mb-0">Sisteme kayıtlı domainleriniz ve entegrasyon scriptleri</p>
        </div>
        <a asp-action="Add" class="btn btn-primary">
            + Yeni Site Ekle
        </a>
    </div>

    @if (TempData["Success"] is string successMsg)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMsg
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <div style="font-size:3rem;">🌐</div>
                <h5 class="mt-3">Henüz site eklemediniz</h5>
                <p class="text-muted">İlk web sitenizi ekleyerek erişilebilirlik entegrasyonuna başlayın.</p>
                <a asp-action="Add" class="btn btn-primary">İlk Siteyi Ekle</a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var domain in Model)
            {
                <div class="col-12">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">

                                <div>
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <h5 class="mb-0">@domain.DomainUrl</h5>
                                        @if (domain.IsVerified)
                                        {
                                            <span class="badge bg-success">Doğrulandı</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">Script Bekleniyor</span>
                                        }
                                    </div>
                                    <small class="text-muted">
                                        Eklenme: @domain.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                        &nbsp;·&nbsp;
                                        Key: <code>@domain.LicenseKey.ToString()[..8]…</code>
                                    </small>
                                </div>

                                <div class="d-flex gap-2">
                                    <a asp-action="Script" asp-route-id="@domain.Id"
                                       class="btn btn-outline-primary btn-sm">
                                        &lt;/&gt; Script Al
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@domain.Id" method="post"
                                          onsubmit="return confirm('@domain.DomainUrl adresini silmek istediğinize emin misiniz?')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger btn-sm">Sil</button>
                                    </form>
                                </div>

                            </div>

                            <!-- Script önizleme -->
                            <div class="mt-3">
                                <label class="form-label text-muted small">Entegrasyon Scripti</label>
                                <div class="input-group">
                                    <input type="text" class="form-control form-control-sm font-monospace"
                                           value="@domain.ScriptTag" readonly id="script-@domain.Id" />
                                    <button class="btn btn-outline-secondary btn-sm"
                                            onclick="copyScript('script-@domain.Id', this)" type="button">
                                        Kopyala
                                    </button>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    }

</div>

@section Scripts {
    <script>
        function copyScript(inputId, btn) {
            const input = document.getElementById(inputId);
            navigator.clipboard.writeText(input.value).then(() => {
                const orig = btn.textContent;
                btn.textContent = 'Kopyalandı ✓';
                btn.classList.replace('btn-outline-secondary', 'btn-success');
                setTimeout(() => {
                    btn.textContent = orig;
                    btn.classList.replace('btn-success', 'btn-outline-secondary');
                }, 2000);
            });
        }
    </script>
}
