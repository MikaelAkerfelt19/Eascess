@model Eascess.Models.RegisterViewModel
@{
    ViewData["Title"] = "Hesap Oluştur";
    Layout = "_AuthLayout";
}

<div class="auth-card">

    <div class="auth-brand">
        <div class="auth-brand-icon">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 1L3 5v6c0 5.25 3.75 10.15 9 11.32C17.25 21.15 21 16.25 21 11V5L12 1zm0 4a3 3 0 110 6 3 3 0 010-6zm0 8c-2.67 0-8 1.34-8 4v1h16v-1c0-2.66-5.33-4-8-4z"/>
            </svg>
        </div>
        <span class="auth-brand-name">Eascess</span>
    </div>

    <h1 class="auth-heading">Hesabınızı oluşturun</h1>
    <p class="auth-subheading">Web'i herkes için erişilebilir yapın</p>

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
    {
        <div class="alert-danger">
            <div asp-validation-summary="All" class="text-danger"></div>
        </div>
    }

    <form asp-action="Register" asp-controller="Account" method="post" novalidate>
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label class="form-label" asp-for="FullName">Ad Soyad</label>
            <input class="form-control" asp-for="FullName" type="text"
                   placeholder="Ahmet Yılmaz" autocomplete="name" autofocus />
            <span asp-validation-for="FullName" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label class="form-label" asp-for="Email">E-posta adresi</label>
            <input class="form-control" asp-for="Email" type="email"
                   placeholder="siz@firma.com" autocomplete="email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label class="form-label" asp-for="Password">Şifre</label>
            <input class="form-control" asp-for="Password" type="password"
                   placeholder="En az 8 karakter" autocomplete="new-password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="form-group" style="margin-bottom:1.5rem;">
            <label class="form-label" asp-for="ConfirmPassword">Şifre tekrar</label>
            <input class="form-control" asp-for="ConfirmPassword" type="password"
                   placeholder="••••••••" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>

        <button type="submit" class="btn-auth">Hesap Oluştur</button>
    </form>

    <div class="divider">
        <div class="divider-line"></div>
        <span class="divider-text">Zaten hesabınız var mı?</span>
        <div class="divider-line"></div>
    </div>

    <p class="auth-footer-text">
        <a asp-action="Login" asp-controller="Account">Giriş yapın</a>
    </p>

</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
