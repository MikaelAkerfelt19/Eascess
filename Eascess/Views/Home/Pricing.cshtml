@{
    ViewData["Title"] = "Fiyatlandırma";
}

<!-- Başlık -->
<section class="ea-mkt-section--hero" data-ea-reveal="fade-up">
    <div class="ea-mkt-eyebrow-pill">
        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2l1.5 5.5L19 9l-5.5 1.5L12 16l-1.5-5.5L5 9l5.5-1.5z"/></svg>
        Şeffaf fiyatlandırma
    </div>
    <h1 class="ea-mkt-title">Doğru planı seçin</h1>
    <p class="ea-mkt-subtitle">Küçük sitelerden kurumsal altyapıya kadar her ölçek için uygun fiyatlandırma.</p>
</section>

<!-- Planlar -->
<section class="ea-mkt-section--plans" data-ea-reveal="fade-up" data-ea-delay="0.1s">
    <div class="ea-pricing-grid ea-mkt-inner">

        <!-- Ücretsiz -->
        <div class="ea-card ea-pricing-card">
            <div class="ea-pricing-tier">Ücretsiz</div>
            <div class="ea-pricing-price">₺0</div>
            <div class="ea-pricing-period">/ ay, sonsuza kadar</div>
            <a asp-controller="Account" asp-action="Register" class="ea-btn ea-btn-ghost ea-pricing-cta">Ücretsiz Başla</a>
            <div class="ea-pricing-features">
                @foreach (var f in new[] {
                    "1 domain",
                    "Aylık 50 AI görsel taraması",
                    "WCAG 2.2 otomatik denetim",
                    "Erişilebilirlik widget'ı",
                    "Temel raporlar",
                    "Topluluk desteği",
                })
                {
                    <div class="ea-pricing-feature">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="var(--success)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
                        @f
                    </div>
                }
            </div>
        </div>

        <!-- Pro (öne çıkan) -->
        <div class="ea-card ea-pricing-card ea-pricing-card--featured">
            <div class="ea-pricing-badge">En Popüler</div>
            <div class="ea-pricing-tier ea-pricing-tier--featured">Pro</div>
            <div class="ea-pricing-price">₺299</div>
            <div class="ea-pricing-period">/ ay (KDV dahil)</div>
            <a asp-controller="Account" asp-action="Register" class="ea-btn ea-btn-brand ea-pricing-cta">14 Gün Ücretsiz Dene</a>
            <div class="ea-pricing-features">
                @foreach (var f in new[] {
                    "10 domain",
                    "Aylık 2.000 AI görsel taraması",
                    "Sürekli otomatik yeniden tarama",
                    "Widget özelleştirme (tema, konum, dil)",
                    "Detaylı sayfa bazlı raporlar",
                    "WCAG 2.2 A / AA / AAA denetim",
                    "E-posta bildirimleri",
                    "Öncelikli destek",
                })
                {
                    <div class="ea-pricing-feature">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="var(--indigo-700)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
                        @f
                    </div>
                }
            </div>
        </div>

        <!-- Kurumsal -->
        <div class="ea-card ea-pricing-card ea-pricing-card--dark">
            <div class="ea-pricing-tier ea-pricing-tier--dark">Kurumsal</div>
            <div class="ea-pricing-price ea-pricing-price--dark">Teklif</div>
            <div class="ea-pricing-period ea-pricing-period--dark">ihtiyacınıza özel</div>
            <a href="mailto:hello@eascess.io" class="ea-btn ea-btn--white ea-pricing-cta">Bizimle İletişime Geçin</a>
            <div class="ea-pricing-features">
                @foreach (var f in new[] {
                    "Sınırsız domain",
                    "Sınırsız AI görsel taraması",
                    "Pro planın tüm özellikleri",
                    "SSO / SAML entegrasyonu",
                    "Özel SLA garantisi",
                    "Özel hesap yöneticisi",
                    "On-premise kurulum (talep üzerine)",
                    "Fatura ile ödeme",
                })
                {
                    <div class="ea-pricing-feature ea-pricing-feature--dark">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="var(--teal-500)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
                        @f
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<!-- Özellik karşılaştırma tablosu -->
<section class="ea-mkt-section--plans ea-mkt-section--alt" data-ea-reveal="fade-up">
    <div class="ea-mkt-inner--md">
        <h2 class="ea-mkt-h2 ea-mkt-h2--center">Plan Karşılaştırması</h2>
        <div class="ea-card" style="padding:0;overflow:hidden">
            <table class="ea-table">
                <thead>
                    <tr>
                        <th style="width:45%">Özellik</th>
                        <th style="text-align:center">Ücretsiz</th>
                        <th style="text-align:center;color:var(--indigo-700)">Pro</th>
                        <th style="text-align:center">Kurumsal</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var rows = new[] {
                            new { Ozellik = "Domain sayısı",            Free = "1",        Pro = "10",        Ent = "Sınırsız" },
                            new { Ozellik = "AI görsel taraması/ay",    Free = "50",       Pro = "2.000",     Ent = "Sınırsız" },
                            new { Ozellik = "WCAG denetim",             Free = "✓",        Pro = "✓",         Ent = "✓" },
                            new { Ozellik = "Erişilebilirlik widget'ı", Free = "✓",        Pro = "✓",         Ent = "✓" },
                            new { Ozellik = "Widget özelleştirme",      Free = "—",        Pro = "✓",         Ent = "✓" },
                            new { Ozellik = "Otomatik yeniden tarama",  Free = "—",        Pro = "✓",         Ent = "✓" },
                            new { Ozellik = "Detaylı raporlar",         Free = "—",        Pro = "✓",         Ent = "✓" },
                            new { Ozellik = "E-posta bildirimleri",     Free = "—",        Pro = "✓",         Ent = "✓" },
                            new { Ozellik = "SSO / SAML",               Free = "—",        Pro = "—",         Ent = "✓" },
                            new { Ozellik = "Fatura ile ödeme",         Free = "—",        Pro = "—",         Ent = "✓" },
                            new { Ozellik = "Destek",                   Free = "Topluluk", Pro = "Öncelikli", Ent = "Özel" },
                        };
                    }
                    @foreach (var r in rows)
                    {
                        <tr>
                            <td style="font-weight:500;color:var(--ink-800)">@r.Ozellik</td>
                            <td style="text-align:center">
                                @if (r.Free == "✓") {
                                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="var(--success)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="Dahil"><path d="M20 6L9 17l-5-5"/></svg>
                                } else if (r.Free == "—") {
                                    <span style="color:var(--ink-400)" aria-label="Dahil değil">—</span>
                                } else {
                                    <span style="font-weight:600;color:var(--ink-700)">@r.Free</span>
                                }
                            </td>
                            <td style="text-align:center">
                                @if (r.Pro == "✓") {
                                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="var(--indigo-700)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="Dahil"><path d="M20 6L9 17l-5-5"/></svg>
                                } else if (r.Pro == "—") {
                                    <span style="color:var(--ink-400)" aria-label="Dahil değil">—</span>
                                } else {
                                    <span style="font-weight:700;color:var(--indigo-700)">@r.Pro</span>
                                }
                            </td>
                            <td style="text-align:center">
                                @if (r.Ent == "✓") {
                                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="var(--success)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="Dahil"><path d="M20 6L9 17l-5-5"/></svg>
                                } else if (r.Ent == "—") {
                                    <span style="color:var(--ink-400)" aria-label="Dahil değil">—</span>
                                } else {
                                    <span style="font-weight:600;color:var(--ink-700)">@r.Ent</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

<!-- SSS -->
<section class="ea-mkt-section" data-ea-reveal="fade-up">
    <div class="ea-mkt-inner--narrow">
        <h2 class="ea-mkt-h2 ea-mkt-h2--center">Sık Sorulan Sorular</h2>
        <div class="ea-faq-list">
            @{
                var faqs = new[] {
                    new { S = "Ücretsiz plan ne kadar süre ücretsiz?", C = "Sonsuza kadar. Kredi kartı gerektirmez. Limitleri yeterli geldiği sürece ücretsiz planı kullanmaya devam edebilirsiniz." },
                    new { S = "14 günlük deneme sona erince ne olur?", C = "Deneme bitince otomatik ücretlendirme yapılmaz. İsterseniz Pro'ya geçebilir, isterseniz ücretsiz plana dönebilirsiniz." },
                    new { S = "AI görsel taraması nasıl çalışır?", C = "Widget kurulu sayfanızdaki görseller analiz edilerek eksik alt metinler Google Gemini 2.0 ile otomatik üretilir ve ilgili img elementlerine enjekte edilir." },
                    new { S = "İptal ne zaman geçerli olur?", C = "İstediğiniz zaman iptal edebilirsiniz. İptal, mevcut faturalama döneminin sonuna kadar geçerli olmaz; o döneme ait ücret iade edilmez." },
                    new { S = "Faturalandırma nasıl yapılır?", C = "Kredi kartı ile aylık veya yıllık (yıllık %20 indirimli) ödeme yapabilirsiniz. Kurumsal müşteriler için fatura ile ödeme seçeneği mevcuttur." },
                };
                int faqIdx = 0;
            }
            @foreach (var faq in faqs)
            {
                <div class="ea-accordion-item">
                    <button class="ea-accordion-trigger" onclick="toggleFaq(this)"
                            aria-expanded="false" aria-controls="faq-body-@faqIdx">
                        <span style="font-weight:600;color:var(--ink-900);flex:1;text-align:left">@faq.S</span>
                        <svg class="faq-chevron" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink:0;color:var(--ink-400);transition:transform 0.2s cubic-bezier(0.25,1,0.5,1)"><polyline points="6 9 12 15 18 9"/></svg>
                    </button>
                    <div class="ea-accordion-body" id="faq-body-@faqIdx" style="color:var(--ink-600);font-size:14px;line-height:1.6">
                        @faq.C
                    </div>
                </div>
                 faqIdx++;
            }
        </div>
    </div>
</section>

@section Scripts {
    <script>
        function toggleFaq(btn) {
            const body = btn.nextElementSibling;
            const open = body.classList.toggle('open');
            btn.setAttribute('aria-expanded', open);
            const chevron = btn.querySelector('.faq-chevron');
            if (chevron) chevron.style.transform = open ? 'rotate(180deg)' : '';
        }
    </script>
}
