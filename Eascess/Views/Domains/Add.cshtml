@model Eascess.Models.AddDomainViewModel
@{
    ViewData["Title"] = "Domain Ekle";
    ViewData["Active"] = "domains";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}

<!-- Topbar -->
<div class="ea-topbar">
    <div>
        <div class="ea-topbar-eyebrow"><a asp-action="Index" style="color:var(--ink-500)">Domainler</a> / Ekle</div>
        <h1 class="ea-topbar-title">Domain Ekle</h1>
    </div>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;align-items:start">

    <div class="ea-card" style="padding:28px">
        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
        {
            <div class="ea-alert ea-alert--danger" style="margin-bottom:16px">
                <div asp-validation-summary="All"></div>
            </div>
        }

        <form asp-action="Add" method="post" novalidate>
            @Html.AntiForgeryToken()

            <div style="margin-bottom:20px">
                <label asp-for="DomainUrl" class="ea-label">Domain Adresi</label>
                <input asp-for="DomainUrl"
                       class="ea-input"
                       placeholder="example.com"
                       autocomplete="off"
                       autofocus />
                <span asp-validation-for="DomainUrl" class="text-danger"></span>
                <p style="font-size:var(--fs-xs);color:var(--ink-500);margin:8px 0 0">Protokolsüz (https://) de girebilirsiniz. Örn: <strong>siteniz.com</strong></p>
            </div>

            <div style="display:flex;gap:8px">
                <button type="submit" class="ea-btn ea-btn-brand">Domain Ekle</button>
                <a asp-action="Index" class="ea-btn ea-btn-ghost">İptal</a>
            </div>
        </form>
    </div>

    <div class="ea-card" style="padding:24px">
        <div style="font-size:var(--fs-sm);font-weight:600;color:var(--ink-700);margin-bottom:16px;text-transform:uppercase;letter-spacing:.06em">Nasıl Çalışır?</div>
        <ol style="margin:0;padding-left:1.2rem;display:flex;flex-direction:column;gap:12px">
            <li style="font-size:var(--fs-sm);color:var(--ink-600);line-height:1.5">Domaininizi buraya ekleyin</li>
            <li style="font-size:var(--fs-sm);color:var(--ink-600);line-height:1.5">Oluşturulan <code>&lt;script&gt;</code> etiketini kopyalayın</li>
            <li style="font-size:var(--fs-sm);color:var(--ink-600);line-height:1.5">Sitenizin kapanış <code>&lt;/body&gt;</code> etiketinden önce yapıştırın</li>
            <li style="font-size:var(--fs-sm);color:var(--ink-600);line-height:1.5">Eascess widget'ı sitenizde otomatik olarak görünür</li>
        </ol>
    </div>

</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
