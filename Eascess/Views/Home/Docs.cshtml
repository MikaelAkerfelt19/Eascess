@{
    ViewData["Title"] = "Belgeler";
}

<div class="ea-docs-layout">

    <!-- Sol kenar çubuğu -->
    <nav class="ea-docs-nav" id="docs-nav" aria-label="Belge gezinmesi">

        <div class="ea-docs-nav__heading">Başlarken</div>
        <a href="#hizli-baslangic" class="ea-nav-item" style="font-size:13px">Hızlı Başlangıç</a>
        <a href="#domain-ekleme"   class="ea-nav-item" style="font-size:13px">Domain Ekleme</a>
        <a href="#kurulum"         class="ea-nav-item" style="font-size:13px">Widget Kurulumu</a>

        <div class="ea-docs-nav__heading ea-docs-nav__heading--spaced">Widget</div>
        <a href="#script-etiketi"  class="ea-nav-item" style="font-size:13px">Script Etiketi</a>
        <a href="#ozellikler"      class="ea-nav-item" style="font-size:13px">Özellikler</a>
        <a href="#ayarlar"         class="ea-nav-item" style="font-size:13px">Görünüm Ayarları</a>

        <div class="ea-docs-nav__heading ea-docs-nav__heading--spaced">API</div>
        <a href="#api-lisans"      class="ea-nav-item" style="font-size:13px">Lisans Doğrulama</a>
        <a href="#api-config"      class="ea-nav-item" style="font-size:13px">Widget Config</a>
        <a href="#api-ai"          class="ea-nav-item" style="font-size:13px">AI Alt Metin</a>

    </nav>

    <!-- İçerik -->
    <div class="ea-docs-body">

        <!-- ── Hızlı Başlangıç ── -->
        <div id="hizli-baslangic" class="ea-docs-section">
            <div class="ea-docs-tag-pill">Başlarken</div>
            <h1 class="ea-docs-h1">Hızlı Başlangıç</h1>
            <p class="ea-docs-lead">Eascess'i sitenize entegre etmek yalnızca 3 adım alır.</p>

            <div class="ea-docs-step-list">
                @foreach (var adim in new[] {
                    new { N = "1", Baslik = "Hesap oluşturun",     Icerik = "Eascess'e ücretsiz hesap açın. Kredi kartı gerektirmez, kurulum dakikalar içinde tamamlanır." },
                    new { N = "2", Baslik = "Domain ekleyin",      Icerik = "Panel'den <strong>Domain Ekle</strong> ile sitenizin URL'sini girin. Size özel lisans anahtarı otomatik üretilir." },
                    new { N = "3", Baslik = "Script'i yapıştırın", Icerik = "Oluşturulan <code>&lt;script&gt;</code> etiketini sitenizin <code>&lt;/body&gt;</code> kapanışından önce yapıştırın. Widget hazır." },
                })
                {
                    <div class="ea-docs-step">
                        <div class="ea-docs-step-num">@adim.N</div>
                        <div>
                            <div class="ea-docs-step-title">@adim.Baslik</div>
                            <p class="ea-docs-step-desc">@Html.Raw(adim.Icerik)</p>
                        </div>
                    </div>
                }
            </div>
        </div>

        <hr class="ea-docs-hr">

        <!-- ── Domain Ekleme ── -->
        <div id="domain-ekleme" class="ea-docs-section">
            <div class="ea-docs-tag-pill">Başlarken</div>
            <h2 class="ea-docs-h1" style="font-size:36px">Domain Ekleme</h2>
            <p class="ea-docs-lead">Her siteniz için ayrı bir domain kaydı ve lisans anahtarı gerekir.</p>

            <div class="ea-docs-step-list">
                @foreach (var adim in new[] {
                    new { N = "1", Baslik = "Domainler sayfasına gidin", Icerik = "Giriş yaptıktan sonra sol menüden <strong>Domainler</strong> bağlantısını açın." },
                    new { N = "2", Baslik = "Domain Ekle",               Icerik = "Sağ üstteki <strong>+ Domain Ekle</strong> butonuna tıklayın ve sitenizin tam URL'sini girin (örn: <code>https://orneksite.com</code>)." },
                    new { N = "3", Baslik = "Lisans anahtarını alın",    Icerik = "Kayıt sonrası otomatik üretilen anahtarı kopyalayın. Bu anahtarı script etiketinin <code>data-key</code> değeri olarak kullanın." },
                    new { N = "4", Baslik = "Taramayı başlatın",         Icerik = "Domain listesinde <strong>Tara</strong> butonuna basarak ilk WCAG uyumluluk raporunuzu alın." },
                })
                {
                    <div class="ea-docs-step">
                        <div class="ea-docs-step-num">@adim.N</div>
                        <div>
                            <div class="ea-docs-step-title">@adim.Baslik</div>
                            <p class="ea-docs-step-desc">@Html.Raw(adim.Icerik)</p>
                        </div>
                    </div>
                }
            </div>

            <div class="ea-card ea-card--info" style="margin-top:20px">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="var(--teal-600)" stroke-width="2" stroke-linecap="round" style="flex-shrink:0;margin-top:2px"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                <p class="ea-docs-step-desc">Bir lisans anahtarı yalnızca kaydedildiği domain için geçerlidir. <code>www.orneksite.com</code> ile <code>orneksite.com</code> farklı kayıt gerektirebilir.</p>
            </div>
        </div>

        <hr class="ea-docs-hr">

        <!-- ── Widget Kurulumu ── -->
        <div id="kurulum" class="ea-docs-section">
            <h2 class="ea-docs-h2">Widget Kurulumu</h2>
            <p class="ea-docs-p">Widget'ı sitenize eklemek için tek bir <code>&lt;script&gt;</code> etiketi yeterlidir. Herhangi bir build adımı, npm paketi veya framework bağımlılığı yoktur.</p>

            <div class="ea-docs-step-list">
                @foreach (var adim in new[] {
                    new { N = "1", Baslik = "Panel'den script'i kopyalayın", Icerik = "Panel → Domainler → Script sayfasında hazır kodunuz lisans anahtarıyla birlikte görünür." },
                    new { N = "2", Baslik = "HTML'e yapıştırın",             Icerik = "<code>&lt;/body&gt;</code> kapanış etiketinden hemen önce yapıştırın. Script'in sayfanın en altında olması performansı korur." },
                    new { N = "3", Baslik = "Sayfayı yenileyin",             Icerik = "Tarayıcıda sayfanızı açın. Sağ alt köşede Eascess widget butonu görünüyor olmalı." },
                })
                {
                    <div class="ea-docs-step">
                        <div class="ea-docs-step-num">@adim.N</div>
                        <div>
                            <div class="ea-docs-step-title">@adim.Baslik</div>
                            <p class="ea-docs-step-desc">@Html.Raw(adim.Icerik)</p>
                        </div>
                    </div>
                }
            </div>
        </div>

        <hr class="ea-docs-hr">

        <!-- ── Script Etiketi ── -->
        <div id="script-etiketi" class="ea-docs-section">
            <h2 class="ea-docs-h2">Script Etiketi</h2>
            <p class="ea-docs-p">Aşağıdaki script etiketini HTML'inizin <code>&lt;/body&gt;</code> kapanışından hemen önce yerleştirin:</p>

            <div class="ea-code-block" style="margin-bottom:24px">
                <pre style="margin:0;font-size:13px;line-height:1.7;color:var(--cream-100)">&lt;<span style="color:#93c5fd">script</span>
  <span style="color:#86efac">src</span>=<span style="color:#fbbf24">"https://cdn.eascess.io/widget.js"</span>
  <span style="color:#86efac">data-key</span>=<span style="color:#fbbf24">"YOUR_LICENSE_KEY"</span>
  <span style="color:#86efac">defer</span>
&gt;&lt;/<span style="color:#93c5fd">script</span>&gt;</pre>
            </div>

            <!-- Attribute açıklamaları -->
            <div style="display:flex;flex-direction:column;gap:8px;margin-bottom:20px">
                @foreach (var attr in new[] {
                    new { Ad = "src",      Zorunlu = true,  Aciklama = "Widget'ın CDN adresi. Sürüm yönetimi Eascess tarafından yapılır, her zaman güncel sürümü alırsınız." },
                    new { Ad = "data-key", Zorunlu = true,  Aciklama = "Domain'inize ait lisans anahtarı. Panel → Domainler sayfasından kopyalayın." },
                    new { Ad = "defer",    Zorunlu = false, Aciklama = "Sayfa render'ını engellemez. İçeriğiniz yüklendikten sonra widget çalışır." },
                })
                {
                    <div style="display:flex;gap:12px;align-items:flex-start;padding:12px 16px;background:var(--cream-100);border:1px solid var(--cream-300);border-radius:var(--r-sm)">
                        <code style="font-size:13px;background:var(--cream-200);padding:2px 8px;border-radius:4px;flex-shrink:0;margin-top:1px">@attr.Ad</code>
                        @if (attr.Zorunlu) {
                            <span style="font-size:11px;font-weight:700;color:var(--danger);background:oklch(95% 0.04 27 / 0.3);padding:2px 7px;border-radius:999px;flex-shrink:0;margin-top:2px">Zorunlu</span>
                        } else {
                            <span style="font-size:11px;font-weight:700;color:var(--ink-500);background:var(--cream-200);padding:2px 7px;border-radius:999px;flex-shrink:0;margin-top:2px">İsteğe bağlı</span>
                        }
                        <p style="font-size:13px;color:var(--ink-600);margin:0;line-height:1.5">@attr.Aciklama</p>
                    </div>
                }
            </div>

            <div class="ea-card ea-card--info">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="var(--teal-600)" stroke-width="2" stroke-linecap="round" style="flex-shrink:0;margin-top:2px"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                <p class="ea-docs-step-desc"><strong>YOUR_LICENSE_KEY</strong> kısmını Panel → Domainler sayfanızda bulunan anahtarla değiştirin. Her domain için farklı bir anahtar üretilir.</p>
            </div>
        </div>

        <hr class="ea-docs-hr">

        <!-- ── Widget Özellikleri ── -->
        <div id="ozellikler" class="ea-docs-section">
            <h2 class="ea-docs-h2">Widget Özellikleri</h2>
            <p class="ea-docs-p">Widget açıldığında kullanıcıya aşağıdaki erişilebilirlik seçenekleri sunulur:</p>

            <div class="ea-docs-feat-grid">
                @foreach (var oz in new[] {
                    "Yazı Boyutu Ayarı (7 kademe)",
                    "Yüksek Kontrast / Negatif Kontrast",
                    "Gri Tonlama",
                    "Bağlantı Vurgulama",
                    "Animasyonları Durdur",
                    "Büyük İmleç",
                    "Okuma Rehberi",
                    "Metin Aralığı Artırma",
                    "Disleksi Dostu Font",
                    "AI Görsel Alt Metni (Pro)",
                })
                {
                    <div class="ea-docs-feat-item">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="var(--success)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
                        <span style="font-size:13px;color:var(--ink-800)">@oz</span>
                    </div>
                }
            </div>
        </div>

        <hr class="ea-docs-hr">

        <!-- ── Görünüm Ayarları ── -->
        <div id="ayarlar" class="ea-docs-section">
            <h2 class="ea-docs-h2">Görünüm Ayarları</h2>
            <p class="ea-docs-p">Panel → Widget Stüdyo'dan widget'ınızı marka kimliğinizle uyumlu hale getirebilirsiniz.</p>

            <div style="display:flex;flex-direction:column;gap:10px;margin-bottom:24px">
                @foreach (var ayar in new[] {
                    new { Baslik = "Tema Rengi",   Aciklama = "Widget düğmesi ve panel başlığında kullanılacak rengi seçin. HEX veya HSL değeri girebilirsiniz.", Ikon = "<circle cx='12' cy='12' r='10'/><path d='M12 2a10 10 0 0 1 0 20'/>" },
                    new { Baslik = "Konum",        Aciklama = "Widget butonunun görüneceği köşeyi belirleyin: sağ-alt (varsayılan), sol-alt, sağ-üst veya sol-üst.", Ikon = "<rect x='3' y='3' width='7' height='7' rx='1'/><rect x='14' y='3' width='7' height='7' rx='1'/><rect x='3' y='14' width='7' height='7' rx='1'/><rect x='14' y='14' width='7' height='7' rx='1'/>" },
                    new { Baslik = "Dil",          Aciklama = "Widget arayüzünün dilini seçin. Desteklenen diller: Türkçe, İngilizce, Almanca, Fransızca, İspanyolca.", Ikon = "<circle cx='12' cy='12' r='9'/><path d='M3 12h18M12 3c2.5 3 2.5 15 0 18M12 3c-2.5 3-2.5 15 0 18'/>" },
                    new { Baslik = "AI Alt Metin", Aciklama = "Pro planda etkinleştirerek sayfa görsellerine otomatik alt metin enjeksiyonu yapılmasını sağlayabilirsiniz.", Ikon = "<path d='M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z'/><circle cx='12' cy='12' r='3'/>" },
                })
                {
                    <div class="ea-card" style="padding:16px 20px;display:flex;gap:14px;align-items:flex-start">
                        <div style="width:34px;height:34px;border-radius:8px;background:var(--cream-200);display:grid;place-items:center;flex-shrink:0">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="var(--ink-700)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">@Html.Raw(ayar.Ikon)</svg>
                        </div>
                        <div>
                            <div style="font-size:14px;font-weight:600;color:var(--ink-900);margin-bottom:3px">@ayar.Baslik</div>
                            <p style="font-size:13px;color:var(--ink-600);margin:0;line-height:1.55">@ayar.Aciklama</p>
                        </div>
                    </div>
                }
            </div>

            <div class="ea-card ea-card--info">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="var(--teal-600)" stroke-width="2" stroke-linecap="round" style="flex-shrink:0;margin-top:2px"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                <p class="ea-docs-step-desc">Ayar değişiklikleri kaydedildikten sonra widget otomatik olarak güncellenir; sayfayı yenilemenize gerek yoktur.</p>
            </div>
        </div>

        <hr class="ea-docs-hr">

        <!-- ── API Referansı ── -->
        <div id="api-lisans" class="ea-docs-section">
            <h2 class="ea-docs-h2">API Referansı</h2>
            <p class="ea-docs-p">Tüm API uçnoktaları CORS korumalıdır — yalnızca kayıtlı domainlerden gelen istekler kabul edilir.</p>

            <!-- Lisans doğrulama -->
            <div style="margin-bottom:32px">
                <div class="ea-docs-endpoint">
                    <span class="ea-docs-tag">GET</span>
                    <code style="font-size:14px">/api/license/validate</code>
                </div>
                <p class="ea-docs-p--sm">Lisans anahtarını ve domain eşleşmesini doğrular.</p>
                <div class="ea-code-block" style="font-size:12px">
                    <pre style="margin:0;color:var(--cream-100);line-height:1.7">GET /api/license/validate?key=<span style="color:#fbbf24">{licenseKey}</span>&domain=<span style="color:#fbbf24">{hostname}</span>

<span style="color:#86efac">// Başarılı yanıt</span>
{
  "valid": <span style="color:#93c5fd">true</span>,
  "plan": <span style="color:#fbbf24">"pro"</span>,
  "expiresAt": <span style="color:#93c5fd">null</span>
}

<span style="color:#86efac">// Hata yanıtı</span>
{
  "valid": <span style="color:#93c5fd">false</span>,
  "reason": <span style="color:#fbbf24">"invalid"</span>
}</pre>
                </div>
            </div>

            <!-- Widget config -->
            <div id="api-config" style="margin-bottom:32px">
                <div class="ea-docs-endpoint">
                    <span class="ea-docs-tag">GET</span>
                    <code style="font-size:14px">/api/widget/config</code>
                </div>
                <p class="ea-docs-p--sm">Widget görünüm ayarlarını döndürür (tema rengi, konum, dil, AI durumu).</p>
                <div class="ea-code-block" style="font-size:12px">
                    <pre style="margin:0;color:var(--cream-100);line-height:1.7">GET /api/widget/config?key=<span style="color:#fbbf24">{licenseKey}</span>

{
  "themeColor": <span style="color:#fbbf24">"#38bdf8"</span>,
  "position":   <span style="color:#fbbf24">"bottom-right"</span>,
  "language":   <span style="color:#fbbf24">"tr"</span>,
  "isAiEnabled":<span style="color:#93c5fd">true</span>
}</pre>
                </div>
            </div>

            <!-- AI alt metin -->
            <div id="api-ai">
                <div class="ea-docs-endpoint">
                    <span class="ea-docs-tag ea-docs-tag--post">POST</span>
                    <code style="font-size:14px">/api/scan/alt-text</code>
                </div>
                <p class="ea-docs-p--sm">Görsel URL listesi için AI destekli alt metin üretir. (Pro plan gerektirir)</p>
                <div class="ea-code-block" style="font-size:12px">
                    <pre style="margin:0;color:var(--cream-100);line-height:1.7"><span style="color:#86efac">// İstek gövdesi</span>
{
  "licenseKey": <span style="color:#fbbf24">"YOUR_LICENSE_KEY"</span>,
  "images": [
    <span style="color:#fbbf24">"https://example.com/foto.jpg"</span>,
    <span style="color:#fbbf24">"https://example.com/banner.png"</span>
  ]
}

<span style="color:#86efac">// Yanıt</span>
{
  "results": [
    { "url": <span style="color:#fbbf24">"..."</span>, "altText": <span style="color:#fbbf24">"Masada oturan iki kişi"</span>, "cached": <span style="color:#93c5fd">false</span> }
  ],
  "processedCount": <span style="color:#93c5fd">1</span>,
  "cachedCount":    <span style="color:#93c5fd">0</span>,
  "quotaRemaining": <span style="color:#93c5fd">1999</span>
}</pre>
                </div>
            </div>
        </div>

        <!-- CTA -->
        <div class="ea-docs-cta">
            <div class="ea-docs-cta__title">Sorunuz mu var?</div>
            <p class="ea-docs-cta__desc">Bu belgeler sürekli güncellenmektedir. Bulamadığınız bir bilgi için bize yazın.</p>
            <a href="mailto:hello@eascess.io" class="ea-btn ea-btn-brand">hello@eascess.io</a>
        </div>

    </div><!-- /.ea-docs-body -->

</div><!-- /.ea-docs-layout -->

@section Scripts {
<script>
(function () {
    var navLinks = Array.from(document.querySelectorAll('#docs-nav a[href^="#"]'));
    var sections = navLinks
        .map(function (link) {
            var id = link.getAttribute('href').slice(1);
            var el = document.getElementById(id);
            return el ? { el: el, link: link } : null;
        })
        .filter(Boolean);

    function setActive(link) {
        navLinks.forEach(function (l) { l.classList.remove('active'); });
        link.classList.add('active');
    }

    function onScroll() {
        var scrollY = window.scrollY + 120;
        var current = sections[0];
        sections.forEach(function (s) {
            if (s.el.offsetTop <= scrollY) current = s;
        });
        if (current) setActive(current.link);
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    navLinks.forEach(function (link) {
        link.addEventListener('click', function () { setActive(link); });
    });
})();
</script>
}
