@{
    ViewData["Title"] = "Ana Sayfa";
}

<!-- Hero -->
<section class="ea-hero">
    <div style="max-width:680px">
        <div class="ea-hero__eyebrow">
            ✦ WCAG 2.2 Uyumlu Erişilebilirlik Katmanı
        </div>
        <h1 class="ea-hero__title">
            Web sitenizi<br><span>herkes için</span><br>erişilebilir yapın
        </h1>
        <p class="ea-hero__desc">
            Tek satır kod. Sıfır geliştirici müdahalesi. Yapay zeka destekli erişilebilirlik widget'ı ile
            sitenizi anında WCAG 2.2 standartlarına uyumlu hale getirin.
        </p>
        <div class="ea-hero__actions">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Dashboard" asp-action="Index" class="ea-btn ea-btn--primary ea-btn--lg">
                    Panele Git →
                </a>
            }
            else
            {
                <a asp-controller="Account" asp-action="Register" class="ea-btn ea-btn--primary ea-btn--lg">
                    Ücretsiz Başla →
                </a>
                <a asp-controller="Account" asp-action="Login" class="ea-btn ea-btn--ghost ea-btn--lg">
                    Giriş Yap
                </a>
            }
        </div>
    </div>
</section>

<!-- Feature strip -->
<section class="ea-features">
    <div style="text-align:center; margin-bottom:3rem;">
        <p style="font-size:.8rem; font-weight:600; letter-spacing:.6px; color:var(--ea-sky); text-transform:uppercase; margin:0 0 .6rem;">Neden Eascess?</p>
        <h2 style="font-size:clamp(1.5rem,4vw,2.4rem); font-weight:800; letter-spacing:-.5px; margin:0; color:#fff;">
            Entegrasyon <span style="background:var(--ea-grad);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;">dakikalar içinde</span>
        </h2>
    </div>
    <div class="ea-feature-grid">
        <div class="ea-card ea-feature-card">
            <div class="ea-feature-icon" style="background:rgba(56,189,248,.12)">⚡</div>
            <h3 class="ea-feature-title">Tek Satır Entegrasyon</h3>
            <p class="ea-feature-desc">
                Sitenizin &lt;head&gt; bölümüne bir &lt;script&gt; etiketi yapıştırmanız yeterli.
                Herhangi bir kod değişikliğine gerek yok.
            </p>
        </div>
        <div class="ea-card ea-feature-card">
            <div class="ea-feature-icon" style="background:rgba(192,132,252,.12)">🤖</div>
            <h3 class="ea-feature-title">Yapay Zeka Desteği</h3>
            <p class="ea-feature-desc">
                Azure Computer Vision ile eksik alt metinler otomatik doldurulur.
                Görme engelli kullanıcılar için eksiksiz deneyim.
            </p>
        </div>
        <div class="ea-card ea-feature-card">
            <div class="ea-feature-icon" style="background:rgba(34,211,238,.12)">📊</div>
            <h3 class="ea-feature-title">Detaylı Raporlama</h3>
            <p class="ea-feature-desc">
                WCAG 2.2 uyumluluk skoru, hata dağılımı ve sayfa bazlı
                erişilebilirlik sorunlarını takip edin.
            </p>
        </div>
        <div class="ea-card ea-feature-card">
            <div class="ea-feature-icon" style="background:rgba(232,121,249,.12)">🔒</div>
            <h3 class="ea-feature-title">İzole & Güvenli</h3>
            <p class="ea-feature-desc">
                Shadow DOM ile sitenizin mevcut CSS'iyle çakışmaz.
                Kullanıcı form verileri asla okunmaz veya kaydedilmez.
            </p>
        </div>
        <div class="ea-card ea-feature-card">
            <div class="ea-feature-icon" style="background:rgba(129,140,248,.12)">🌐</div>
            <h3 class="ea-feature-title">Çoklu Domain</h3>
            <p class="ea-feature-desc">
                Birden fazla web sitenizi tek panelden yönetin.
                Her site için benzersiz lisans anahtarı ve ayarlar.
            </p>
        </div>
        <div class="ea-card ea-feature-card">
            <div class="ea-feature-icon" style="background:rgba(56,189,248,.12)">⚙️</div>
            <h3 class="ea-feature-title">Özelleştirilebilir Widget</h3>
            <p class="ea-feature-desc">
                Tema rengi, konum ve dil ayarları sitenize özel.
                Marka kimliğinizle uyumlu erişilebilirlik deneyimi.
            </p>
        </div>
    </div>
</section>
