@using Eascess_Application.Services
@{
    ViewData["Title"] = "Sitenizi Test Edin";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var result = ViewBag.ScanResult as PublicScanResult;
    var scannedUrl = ViewBag.ScannedUrl as string;
    var rateLimited = ViewBag.RateLimited as bool? ?? false;
}

<section class="ea-test">

    <!-- Başlık -->
    <div class="ea-test-head" data-ea-reveal="fade-up">
        <div class="ea-mkt-eyebrow-pill">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true"><path d="M12 2l1.5 5.5L19 9l-5.5 1.5L12 16l-1.5-5.5L5 9l5.5-1.5z"/></svg>
            Ücretsiz WCAG analizi
        </div>
        <h1>Sitenizin erişilebilirliğini<br><em>hemen</em> test edin</h1>
        <p>WCAG 2.2 kurallarına göre otomatik analiz. Kayıt gerekmez.</p>
    </div>

    <!-- Form -->
    <div class="ea-test-form-card" data-ea-reveal="fade-up" data-ea-delay="0.1s">
        <form method="post" asp-action="TestSite">
            @Html.AntiForgeryToken()
            <div class="ea-test-form">
                <input type="url" name="url" value="@scannedUrl" placeholder="https://example.com"
                       required class="ea-input" aria-label="Test edilecek site adresi"
                       oninvalid="this.setCustomValidity('Lütfen geçerli bir URL girin (https://...)')"
                       oninput="this.setCustomValidity('')" />
                <button type="submit" class="ea-btn ea-btn-brand" style="white-space:nowrap">
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                    Analiz Et
                </button>
            </div>
            @if (!ViewData.ModelState.IsValid)
            {
                foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <p class="ea-test-error">@err.ErrorMessage</p>
                }
            }
        </form>
        <p class="ea-test-meta">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            Günde en fazla 5 tarama · Sonuçlar kaydedilmez
        </p>
    </div>

    @if (rateLimited)
    {
        <div class="ea-callout ea-callout--danger">
            <strong>Günlük limit aşıldı.</strong> Bugün için 5 tarama hakkınızı kullandınız.
            Sınırsız tarama için <a asp-controller="Account" asp-action="Register">ücretsiz hesap açın</a>.
        </div>
    }

    @if (result is not null)
    {
        @if (!result.Success)
        {
            <div class="ea-callout ea-callout--danger">
                <strong>Tarama başarısız:</strong> @result.ErrorMessage
            </div>
        }
        else
        {
            var ringColor = result.Score >= 80 ? "var(--success-deep)" : result.Score >= 60 ? "var(--warning-deep)" : "var(--danger-deep)";

            <!-- Sonuç paneli -->
            <div class="ea-test-result" data-ea-reveal="fade-up">
                <div class="ea-test-result__head">
                    <div class="ea-score-ring" style="--score:@result.Score; --ring:@ringColor" role="img" aria-label="WCAG skoru: 100 üzerinden @result.Score">
                        <div class="ea-score-ring__inner">
                            <div>
                                <div class="ea-score-ring__value">@result.Score</div>
                                <div class="ea-score-ring__label">/ 100</div>
                            </div>
                        </div>
                    </div>
                    <div>
                        <div class="ea-test-result__counts">
                            <div>
                                <div class="ea-test-count__value ea-test-count__value--danger">@result.CriticalCount</div>
                                <div class="ea-test-count__label">Kritik Sorun</div>
                            </div>
                            <div>
                                <div class="ea-test-count__value ea-test-count__value--warning">@result.WarningCount</div>
                                <div class="ea-test-count__label">Uyarı</div>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(scannedUrl))
                        {
                            <div class="ea-test-result__url">@scannedUrl</div>
                        }
                    </div>
                </div>

                @if (result.TopIssues.Any())
                {
                    <div class="ea-issues__head">
                        <span class="ea-issues__title">Bulunan Sorunlar</span>
                        <span class="ea-issues__meta">İlk @result.TopIssues.Count gösteriliyor</span>
                    </div>
                    <div>
                        @foreach (var issue in result.TopIssues)
                        {
                            var sevClass = issue.Severity switch
                            {
                                "Critical" => "ea-sev--critical",
                                "Warning"  => "ea-sev--warning",
                                _          => "ea-sev--info",
                            };
                            var label = issue.Severity switch
                            {
                                "Critical" => "Kritik",
                                "Warning"  => "Uyarı",
                                _          => "Bilgi",
                            };
                            <div class="ea-issue-row">
                                <span class="ea-sev @sevClass">@label</span>
                                <div>
                                    <div class="ea-issue-row__code">@issue.Code</div>
                                    <div class="ea-issue-row__desc">@issue.Description</div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="ea-test-clean">
                        <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="var(--success-deep)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4L12 14.01l-3-3"/></svg>
                        <p>Harika! Otomatik kontrollerimizde sorun bulunamadı.</p>
                    </div>
                }
            </div>

            <!-- CTA -->
            <div class="ea-test-cta" data-ea-reveal="fade-up" data-ea-delay="0.1s">
                <div class="ea-test-cta__title">Tam raporu ve sürekli izlemeyi deneyin</div>
                <div class="ea-test-cta__desc">14 gün Pro · Kredi kartı gerekmez</div>
                <a asp-controller="Account" asp-action="Register" class="ea-btn ea-btn--white" style="font-weight:700">Ücretsiz Başla</a>
            </div>
        }
    }

</section>
