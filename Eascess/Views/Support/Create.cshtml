@model Eascess.Controllers.SupportTicketFormModel
@{
    ViewData["Title"] = "Yeni Destek Talebi";
    ViewData["Active"] = "support";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}

<!-- Topbar -->
<div class="ea-topbar">
    <div>
        <div class="ea-topbar-eyebrow"><a asp-action="Index" style="color:var(--ink-500)">Destek Talepleri</a> / Yeni</div>
        <h1 class="ea-topbar-title">Yeni Destek Talebi</h1>
    </div>
</div>

<div style="max-width:640px">
    <div class="ea-card" style="padding:28px">
        <form asp-action="Create" method="post" novalidate>
            @Html.AntiForgeryToken()

            <!-- Domain (isteğe bağlı) -->
            <div style="margin-bottom:20px">
                <label class="ea-label" for="DomainId">İlgili Domain <span style="font-weight:400;color:var(--ink-500)">(isteğe bağlı)</span></label>
                <select asp-for="DomainId" class="ea-input" style="max-width:320px">
                    <option value="">— Seçin —</option>
                    @foreach (Microsoft.AspNetCore.Mvc.Rendering.SelectListItem item in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Domains)
                    {
                        if (item.Selected)
                        {
                            <option value="@item.Value" selected="selected">@item.Text</option>
                        }
                        else
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    }
                </select>
            </div>

            <!-- Konu -->
            <div style="margin-bottom:20px">
                <label class="ea-label" asp-for="Subject">Konu</label>
                <input type="text" asp-for="Subject" class="ea-input" placeholder="Sorununuzu kısaca özetleyin" maxlength="200" />
                <span asp-validation-for="Subject" style="color:var(--red-600,#dc2626);font-size:var(--fs-xs);margin-top:4px;display:block"></span>
            </div>

            <!-- Açıklama -->
            <div style="margin-bottom:24px">
                <label class="ea-label" asp-for="Body">Açıklama</label>
                <textarea asp-for="Body" class="ea-input" rows="6"
                          placeholder="Sorununuzu ayrıntılı olarak açıklayın. Ne yapmaya çalıştığınızı, ne olduğunu ve ne olmasını beklediğinizi belirtin."
                          style="resize:vertical"></textarea>
                <span asp-validation-for="Body" style="color:var(--red-600,#dc2626);font-size:var(--fs-xs);margin-top:4px;display:block"></span>
            </div>

            <div style="display:flex;gap:8px">
                <button type="submit" class="ea-btn ea-btn-brand">Talebi Gönder</button>
                <a asp-action="Index" class="ea-btn ea-btn-ghost">İptal</a>
            </div>
        </form>
    </div>

    @if (ViewBag.HasPrioritySupport is true)
    {
        @* Ultra / Kurumsal: öncelikli sıra hafif parlayan panelle belirtilir *@
        <div class="ea-card ea-priority-panel" style="padding:16px 20px;margin-top:12px;display:flex;gap:12px;align-items:flex-start">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="var(--indigo-700)" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;margin-top:1px" aria-hidden="true">
                <path d="M13 2L3 14h8l-1 8 10-12h-8z"/>
            </svg>
            <div style="font-size:var(--fs-sm);color:var(--ink-700)">
                <span class="ea-priority-badge" style="margin-bottom:8px">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M13 2L3 14h8l-1 8 10-12h-8z"/>
                    </svg>
                    Öncelikli Destek
                </span>
                <div style="margin-top:8px">
                    <strong style="color:var(--ink-900)">@ViewBag.PlanName planındasınız.</strong>
                    Bu talep öncelikli sıraya alınacak ve standart taleplerden önce yanıtlanacaktır.
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="ea-card" style="padding:16px 20px;margin-top:12px;display:flex;gap:12px;align-items:flex-start">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="var(--teal-600,#0d9488)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;margin-top:1px">
                <circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/>
            </svg>
            <div style="font-size:var(--fs-sm);color:var(--ink-600)">
                Talepler genellikle <strong>1–2 iş günü</strong> içinde yanıtlanır.
                Acil erişilebilirlik sorunları için lütfen talebinizde bunu belirtin.
            </div>
        </div>
    }
</div>
