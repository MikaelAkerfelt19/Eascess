@{
    ViewData["Title"] = "Fiyatlandırma";
}

<!-- Başlık -->
<section style="padding:60px 56px 48px;text-align:center">
    <div style="display:inline-flex;align-items:center;gap:8px;background:white;border:1px solid var(--cream-300);padding:6px 14px;border-radius:999px;font-size:12px;font-weight:600;color:var(--ink-700);box-shadow:var(--sh-sm);margin-bottom:20px">
        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2l1.5 5.5L19 9l-5.5 1.5L12 16l-1.5-5.5L5 9l5.5-1.5z"/></svg>
        Şeffaf fiyatlandırma
    </div>
    <h1 style="font-family:var(--font-display);font-size:clamp(36px,5vw,58px);line-height:1;letter-spacing:-0.03em;margin:0 0 16px;font-weight:400">
        Doğru planı seçin
    </h1>
    <p style="font-size:18px;color:var(--ink-600);max-width:520px;margin:0 auto;line-height:1.6">
        Küçük sitelerden kurumsal altyapıya kadar her ölçek için uygun fiyatlandırma.
    </p>
</section>

<!-- Planlar -->
<section style="padding:0 56px 64px">
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;max-width:1100px;margin:0 auto">

        <!-- Ücretsiz -->
        <div class="ea-card" style="padding:32px">
            <div style="font-size:13px;font-weight:600;color:var(--ink-500);text-transform:uppercase;letter-spacing:.06em;margin-bottom:12px">Ücretsiz</div>
            <div style="font-family:var(--font-display);font-size:48px;font-weight:400;letter-spacing:-0.03em;line-height:1;color:var(--ink-900);margin-bottom:4px">₺0</div>
            <div style="font-size:13px;color:var(--ink-500);margin-bottom:24px">/ ay, sonsuza kadar</div>
            <a asp-controller="Account" asp-action="Register" class="ea-btn ea-btn-ghost" style="width:100%;justify-content:center;margin-bottom:28px">Ücretsiz Başla</a>

            <div style="display:flex;flex-direction:column;gap:12px">
                @foreach (var f in new[] {
                    "1 domain",
                    "Aylık 50 AI görsel taraması",
                    "WCAG 2.2 otomatik denetim",
                    "Erişilebilirlik widget'ı",
                    "Temel raporlar",
                    "Topluluk desteği",
                })
                {
                    <div style="display:flex;align-items:center;gap:10px;font-size:14px;color:var(--ink-700)">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="var(--success)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
                        @f
                    </div>
                }
            </div>
        </div>

        <!-- Pro (öne çıkan) -->
        <div class="ea-card" style="padding:32px;border-color:var(--indigo-700);background:white;position:relative;box-shadow:var(--sh-lg)">
            <div style="position:absolute;top:-14px;left:50%;transform:translateX(-50%);background:var(--brand-grad);color:white;font-size:12px;font-weight:600;padding:4px 16px;border-radius:999px;white-space:nowrap">En Popüler</div>
            <div style="font-size:13px;font-weight:600;color:var(--indigo-700);text-transform:uppercase;letter-spacing:.06em;margin-bottom:12px">Pro</div>
            <div style="font-family:var(--font-display);font-size:48px;font-weight:400;letter-spacing:-0.03em;line-height:1;color:var(--ink-900);margin-bottom:4px">₺299</div>
            <div style="font-size:13px;color:var(--ink-500);margin-bottom:24px">/ ay (KDV dahil)</div>
            <a asp-controller="Account" asp-action="Register" class="ea-btn ea-btn-brand" style="width:100%;justify-content:center;margin-bottom:28px">14 Gün Ücretsiz Dene</a>

            <div style="display:flex;flex-direction:column;gap:12px">
                @foreach (var f in new[] {
                    "10 domain",
                    "Aylık 2.000 AI görsel taraması",
                    "Sürekli otomatik yeniden tarama",
                    "Widget özelleştirme (tema, konum, dil)",
                    "Detaylı sayfa bazlı raporlar",
                    "WCAG 2.2 A / AA / AAA denetim",
                    "E-posta bildirimleri",
                    "Öncelikli destek",
                })
                {
                    <div style="display:flex;align-items:center;gap:10px;font-size:14px;color:var(--ink-700)">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="var(--indigo-700)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
                        @f
                    </div>
                }
            </div>
        </div>

        <!-- Kurumsal -->
        <div class="ea-card" style="padding:32px;background:var(--ink-900);border-color:var(--ink-800)">
            <div style="font-size:13px;font-weight:600;color:var(--teal-500);text-transform:uppercase;letter-spacing:.06em;margin-bottom:12px">Kurumsal</div>
            <div style="font-family:var(--font-display);font-size:48px;font-weight:400;letter-spacing:-0.03em;line-height:1;color:white;margin-bottom:4px">Teklif</div>
            <div style="font-size:13px;color:oklch(65% 0.02 260);margin-bottom:24px">ihtiyacınıza özel</div>
            <a href="mailto:hello@eascess.io" class="ea-btn" style="width:100%;justify-content:center;margin-bottom:28px;background:white;color:var(--ink-900)">Bizimle İletişime Geçin</a>

            <div style="display:flex;flex-direction:column;gap:12px">
                @foreach (var f in new[] {
                    "Sınırsız domain",
                    "Sınırsız AI görsel taraması",
                    "Pro planın tüm özellikleri",
                    "SSO / SAML entegrasyonu",
                    "Özel SLA garantisi",
                    "Dedicated account manager",
                    "On-premise kurulum (talep üzerine)",
                    "Fatura ile ödeme",
                })
                {
                    <div style="display:flex;align-items:center;gap:10px;font-size:14px;color:oklch(80% 0.02 260)">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="var(--teal-500)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
                        @f
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<!-- Özellik karşılaştırma tablosu -->
<section style="padding:0 56px 64px;background:var(--cream-100);border-top:1px solid var(--cream-200);border-bottom:1px solid var(--cream-200)">
    <div style="max-width:900px;margin:0 auto;padding-top:56px">
        <h2 style="font-family:var(--font-display);font-size:32px;font-weight:400;letter-spacing:-0.02em;margin:0 0 32px;text-align:center">Plan Karşılaştırması</h2>
        <div class="ea-card" style="padding:0;overflow:hidden">
            <table class="ea-table">
                <thead>
                    <tr>
                        <th style="width:45%">Özellik</th>
                        <th style="text-align:center">Ücretsiz</th>
                        <th style="text-align:center;color:var(--indigo-700)">Pro</th>
                        <th style="text-align:center">Kurumsal</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var rows = new[] {
                            new { Ozellik = "Domain sayısı",          Free = "1",        Pro = "10",        Ent = "Sınırsız" },
                            new { Ozellik = "AI görsel taraması/ay",  Free = "50",       Pro = "2.000",     Ent = "Sınırsız" },
                            new { Ozellik = "WCAG denetim",           Free = "✓",        Pro = "✓",         Ent = "✓" },
                            new { Ozellik = "Erişilebilirlik widget'ı", Free = "✓",      Pro = "✓",         Ent = "✓" },
                            new { Ozellik = "Widget özelleştirme",    Free = "—",        Pro = "✓",         Ent = "✓" },
                            new { Ozellik = "Otomatik yeniden tarama",Free = "—",        Pro = "✓",         Ent = "✓" },
                            new { Ozellik = "Detaylı raporlar",       Free = "—",        Pro = "✓",         Ent = "✓" },
                            new { Ozellik = "E-posta bildirimleri",   Free = "—",        Pro = "✓",         Ent = "✓" },
                            new { Ozellik = "SSO / SAML",             Free = "—",        Pro = "—",         Ent = "✓" },
                            new { Ozellik = "Fatura ile ödeme",       Free = "—",        Pro = "—",         Ent = "✓" },
                            new { Ozellik = "Destek",                 Free = "Topluluk", Pro = "Öncelikli", Ent = "Dedicated" },
                        };
                    }
                    @foreach (var r in rows)
                    {
                        <tr>
                            <td style="font-weight:500;color:var(--ink-800)">@r.Ozellik</td>
                            <td style="text-align:center;color:@(r.Free == "—" ? "var(--ink-300)" : "var(--ink-700)")">@r.Free</td>
                            <td style="text-align:center;font-weight:@(r.Pro == "✓" || r.Pro == "—" ? "400" : "600");color:@(r.Pro == "—" ? "var(--ink-300)" : "var(--indigo-700)")">@r.Pro</td>
                            <td style="text-align:center;color:@(r.Ent == "—" ? "var(--ink-300)" : "var(--ink-700)")">@r.Ent</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

<!-- SSS -->
<section style="padding:56px">
    <div style="max-width:720px;margin:0 auto">
        <h2 style="font-family:var(--font-display);font-size:32px;font-weight:400;letter-spacing:-0.02em;margin:0 0 32px;text-align:center">Sık Sorulan Sorular</h2>
        <div style="display:flex;flex-direction:column;gap:2px">
            @{
                var faqs = new[] {
                    new { S = "Ücretsiz plan ne kadar süre ücretsiz?", C = "Sonsuza kadar. Kredi kartı gerektirmez. Limitleri yeterli geldiği sürece ücretsiz planı kullanmaya devam edebilirsiniz." },
                    new { S = "14 günlük deneme sona erince ne olur?", C = "Deneme bitince otomatik ücretlendirme yapılmaz. İsterseniz Pro'ya geçebilir, isterseniz ücretsiz plana dönebilirsiniz." },
                    new { S = "AI görsel taraması nasıl çalışır?", C = "Widget kurulu sayfanızdaki görseller analiz edilerek eksik alt metinler Google Gemini 2.0 ile otomatik üretilir ve ilgili img elementlerine enjekte edilir." },
                    new { S = "İptal ne zaman geçerli olur?", C = "İstediğiniz zaman iptal edebilirsiniz. İptal, mevcut faturalama döneminin sonuna kadar geçerli olmaz; o döneme ait ücret iade edilmez." },
                    new { S = "Faturalandırma nasıl yapılır?", C = "Kredi kartı ile aylık veya yıllık (yıllık %20 indirimli) ödeme yapabilirsiniz. Kurumsal müşteriler için fatura ile ödeme seçeneği mevcuttur." },
                };
            }
            @foreach (var faq in faqs)
            {
                <div class="ea-accordion-item">
                    <button class="ea-accordion-trigger" onclick="toggleFaq(this)">
                        <span style="font-weight:600;color:var(--ink-900);flex:1;text-align:left">@faq.S</span>
                        <span style="color:var(--ink-400);font-size:11px;flex-shrink:0">▸</span>
                    </button>
                    <div class="ea-accordion-body" style="color:var(--ink-600);font-size:14px;line-height:1.6">
                        @faq.C
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@section Scripts {
    <script>
        function toggleFaq(btn) {
            const body = btn.nextElementSibling;
            const arr  = btn.querySelector('span:last-child');
            const open = body.classList.toggle('open');
            arr.textContent = open ? '▾' : '▸';
        }
    </script>
}
