@{
    ViewData["Title"] = "Erişilebilirlik, nazikçe sunuldu.";
}

<!-- Hero -->
<section class="ea-hero">

    <!-- Dekoratif aydınlık topları -->
    <div class="ea-orb" style="top:-100px;right:-80px;width:480px;height:480px;background:var(--brand-grad);filter:blur(120px);opacity:.18"></div>
    <div class="ea-orb" style="bottom:-120px;left:-40px;width:360px;height:360px;background:radial-gradient(circle,oklch(72% 0.11 190 / 0.25),transparent 70%);filter:blur(80px)"></div>

    <!-- Sol: başlık ve açıklama -->
    <div class="ea-hero__left">
        <h1 class="ea-hero__title">
            Erişilebilirlik,<br>
            <span>nazikçe sunuldu.</span>
        </h1>

        <p class="ea-hero__desc">
            Tek satır JavaScript ile her ziyaretçiye kontrast, hareket, yazı tipi ve
            boşluk kontrolü sağlayın; üstelik kendini sürekli yenileyen bir WCAG 2.2 denetimiyle.
        </p>

        <div class="ea-hero__actions">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Dashboard" asp-action="Index" class="ea-btn ea-btn-brand" style="font-size:15px;padding:14px 22px;min-height:52px">
                    Panele Git
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
                </a>
            }
            else
            {
                <a asp-controller="Account" asp-action="Register" class="ea-btn ea-btn-brand" style="font-size:15px;padding:14px 22px;min-height:52px">
                    Widget'ı Yükle
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
                </a>
                <a asp-controller="Account" asp-action="Login" class="ea-btn ea-btn-ghost" style="font-size:15px;padding:14px 22px;min-height:52px;background:white">
                    Giriş Yap
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
                </a>
            }
        </div>

        <!-- İstatistikler -->
        <div class="ea-hero__stats">
            @foreach (var stat in new[] {
                new { V = "2.3m",  L = "Sunulan oturum" },
                new { V = "AAA",   L = "Varsayılan hedef" },
                new { V = "4.1kb", L = "Gzip, sıfır bağımlılık" },
                new { V = "<40ms", L = "Yükleme süresi" },
            })
            {
                <div>
                    <div class="ea-hero__stat-val">@stat.V</div>
                    <div class="ea-hero__stat-label">@stat.L</div>
                </div>
            }
        </div>
    </div>

    <!-- Sağ: widget demo -->
    <div class="ea-hero__right" style="position:relative;padding-top:10px">
        <div class="ea-demo__eyebrow" style="margin-bottom:10px">İnteraktif Demo</div>
        <div class="ea-demo__frame-wrap" style="margin:0">
            <div class="ea-demo__browser-bar">
                <div class="ea-demo__dots">
                    <span></span><span></span><span></span>
                </div>
                <div class="ea-demo__url-bar">orneksite.com</div>
            </div>
            <iframe class="ea-demo__iframe"
                    src="/widget-demo.html"
                    title="Eascess widget canlı demo"
                    sandbox="allow-scripts allow-same-origin"
                    loading="lazy"
                    style="height:420px"></iframe>
        </div>
    </div>

</section>

<!-- Özellikler -->
<section class="ea-features">
    <div class="ea-features-head" data-ea-reveal="fade-up" data-ea-duration="1.0s">
        <div class="ea-features-eyebrow">Neden Eascess?</div>
        <h2 class="ea-features-title">
            Entegrasyon <span>dakikalar içinde</span>
        </h2>
    </div>

    <div class="ea-feature-grid">

        <div class="ea-feature-item" data-ea-reveal="fade-up" data-ea-delay="0.1s" data-ea-duration="1.1s">
            <div class="ea-feature-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
            </div>
            <div>
                <h3 class="ea-feature-title">Tek Satır Entegrasyon</h3>
                <p class="ea-feature-desc">Sitenizin <code>&lt;/body&gt;</code> etiketinden önce bir <code>&lt;script&gt;</code> yapıştırın. Herhangi bir build adımı yok.</p>
            </div>
        </div>

        <div class="ea-feature-item" data-ea-reveal="fade-up" data-ea-delay="0.25s" data-ea-duration="1.1s">
            <div class="ea-feature-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            </div>
            <div>
                <h3 class="ea-feature-title">Yapay Zeka Alt Metin</h3>
                <p class="ea-feature-desc">Gemini 2.5 ile eksik alt metinler otomatik oluşturulur. Görme engelli kullanıcılar için eksiksiz deneyim.</p>
            </div>
        </div>

        <div class="ea-feature-item" data-ea-reveal="fade-up" data-ea-delay="0.4s" data-ea-duration="1.1s">
            <div class="ea-feature-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
            </div>
            <div>
                <h3 class="ea-feature-title">WCAG 2.2 Denetimi</h3>
                <p class="ea-feature-desc">Kendini sürekli yenileyen uyumluluk skoru, hata dağılımı ve sayfa bazlı sorun takibi.</p>
            </div>
        </div>

        <div class="ea-feature-item" data-ea-reveal="fade-up" data-ea-delay="0.55s" data-ea-duration="1.1s">
            <div class="ea-feature-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <div>
                <h3 class="ea-feature-title">İzole &amp; Güvenli</h3>
                <p class="ea-feature-desc">Shadow DOM ile sitenizin CSS'iyle çakışmaz. Kullanıcı verileri asla okunmaz veya kaydedilmez.</p>
            </div>
        </div>

        <div class="ea-feature-item" data-ea-reveal="fade-up" data-ea-delay="0.7s" data-ea-duration="1.1s">
            <div class="ea-feature-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            </div>
            <div>
                <h3 class="ea-feature-title">Çoklu Domain</h3>
                <p class="ea-feature-desc">Tüm web sitelerinizi tek panelden yönetin. Her site için benzersiz lisans anahtarı ve ayarlar.</p>
            </div>
        </div>

        <div class="ea-feature-item" data-ea-reveal="fade-up" data-ea-delay="0.85s" data-ea-duration="1.1s">
            <div class="ea-feature-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/></svg>
            </div>
            <div>
                <h3 class="ea-feature-title">Widget Stüdyo</h3>
                <p class="ea-feature-desc">Tema rengi, konum ve dil ayarlarını görsel editörden yapın. Marka kimliğinizle uyumlu erişilebilirlik.</p>
            </div>
        </div>

    </div>
</section>


<!-- AI Alt Metin Bölümü -->
<section class="ea-ai-cta">
    <div class="ea-ai-cta__layout">
        <div class="ea-ai-cta__copy" data-ea-reveal="fade-up">
            <div class="ea-ai-cta__badge">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="3"/><path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"/>
                </svg>
                Yapay Zeka Destekli
            </div>
            <h2 class="ea-ai-cta__title">
                Görsellere <em>otomatik alt metin</em> ekleyin
            </h2>
            <p class="ea-ai-cta__desc">
                Widget'ınız sayfadaki tüm resimleri tarar, yapay zeka ile eksik
                alt metinleri anında oluşturur. Görme engelli kullanıcılarınız
                için tek tıkla eksiksiz erişilebilirlik.
            </p>
            <a asp-controller="Account" asp-action="Register" asp-route-ref="ai-alt-text" class="ea-btn ea-btn-brand" style="min-height:48px;padding:12px 24px">
                Ücretsiz Dene
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-left:7px" aria-hidden="true">
                    <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
                </svg>
            </a>
        </div>

        <div class="ea-ai-cta__panel-wrap" data-ea-reveal="scale-in" data-ea-delay="0.15s">
            <!-- Widget panel mockup — AI section görünümü -->
            <div class="ea-ai-mock-panel" aria-hidden="true">
                <div class="ea-ai-mock-panel__head">
                    <span class="ea-ai-mock-panel__title">Erişilebilirlik Araçları</span>
                    <div class="ea-ai-mock-panel__actions">
                        <span class="ea-ai-mock-panel__dot"></span>
                        <span class="ea-ai-mock-panel__dot"></span>
                    </div>
                </div>
                <div class="ea-ai-mock-panel__body">
                    <div class="ea-ai-mock-panel__label">AI</div>
                    <a asp-controller="Account" asp-action="Register" asp-route-ref="ai-alt-text" class="ea-ai-mock-btn" tabindex="-1">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 11.18V9.72c0-.47-.16-.92-.46-1.28l-2.76-3.27c-.3-.36-.74-.57-1.21-.57H7.43c-.47 0-.91.21-1.21.57L3.46 8.44C3.16 8.8 3 9.25 3 9.72v1.46c0 .55.45 1 1 1h.01L4 20c0 .55.45 1 1 1h14c.55 0 1-.45 1-1l-.01-7.82c.56 0 1.01-.45 1.01-1zM12 17c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z"/></svg>
                        AI Alt Metin Üret
                    </a>
                    <div class="ea-ai-mock-panel__hint">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                        Denemek için kayıt olun
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
