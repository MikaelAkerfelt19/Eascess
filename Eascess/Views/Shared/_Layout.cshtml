<!DOCTYPE html>
<html lang="tr" class="ea-mkt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Eascess</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&family=JetBrains+Mono&display=swap">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    @{
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        string? NavCurrent(string action) =>
            string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase)
            && string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase)
                ? "page" : null;
    }

    <a href="#main-content" class="ea-skip-link">İçeriğe geç</a>

    <!-- Pazarlama Navbar -->
    <nav class="ea-navbar" aria-label="Ana gezinme">
        <a class="ea-navbar__brand" asp-controller="Home" asp-action="Index">
            <div class="ea-navbar__logo">
                <img src="~/image/Eascess_logo.png" alt="" />
            </div>
            <span class="ea-navbar__brand-name">Eascess</span>
        </a>

        <div class="ea-navbar__links">
            <a asp-controller="Home" asp-action="Index" aria-current="@NavCurrent("Index")">Ürün</a>
            <a asp-controller="Home" asp-action="Wcag" aria-current="@NavCurrent("Wcag")">WCAG 2.2</a>
            <a asp-controller="Home" asp-action="Pricing" aria-current="@NavCurrent("Pricing")">Fiyatlandırma</a>
            <a asp-controller="Home" asp-action="TestSite" aria-current="@NavCurrent("TestSite")">Sitenizi Test Edin</a>
            <a asp-controller="Home" asp-action="Docs" aria-current="@NavCurrent("Docs")">Belgeler</a>
        </div>

        <div class="ea-navbar__actions">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Dashboard" asp-action="Index" class="ea-btn ea-btn-ghost">Panel</a>
                <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="ea-btn ea-btn-primary">Çıkış</button>
                </form>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="ea-btn ea-btn-ghost">Giriş Yap</a>
                <a asp-controller="Account" asp-action="Register" class="ea-btn ea-btn-brand">Ücretsiz Başla · 14 gün</a>
            }
        </div>
    </nav>

    <!-- Sayfa içeriği -->
    <main id="main-content">
        @RenderBody()
    </main>

    <footer class="ea-footer">
        <div class="ea-footer__grid">
            <div>
                <div class="ea-footer__brand-row">
                    <img src="~/image/Eascess_logo.png" alt="" />
                    <span class="ea-footer__brand-name">Eascess</span>
                </div>
                <p class="ea-footer__tagline">
                    Tek satır kodla WCAG 2.2 uyumlu erişilebilirlik: widget, yapay zeka
                    destekli alt metin ve sürekli denetim, tek platformda.
                </p>
            </div>
            <nav aria-label="Ürün bağlantıları">
                <h2 class="ea-footer__heading">Ürün</h2>
                <div class="ea-footer__links">
                    <a asp-controller="Home" asp-action="Index">Genel Bakış</a>
                    <a asp-controller="Home" asp-action="Wcag">WCAG 2.2 Rehberi</a>
                    <a asp-controller="Home" asp-action="Pricing">Fiyatlandırma</a>
                    <a asp-controller="Home" asp-action="TestSite">Sitenizi Test Edin</a>
                </div>
            </nav>
            <nav aria-label="Kaynak bağlantıları">
                <h2 class="ea-footer__heading">Kaynaklar</h2>
                <div class="ea-footer__links">
                    <a asp-controller="Home" asp-action="Docs">Belgeler</a>
                    <a asp-controller="Account" asp-action="Login">Giriş Yap</a>
                    <a asp-controller="Account" asp-action="Register">Ücretsiz Başla</a>
                </div>
            </nav>
        </div>
        <div class="ea-footer__legal">
            <div class="ea-footer__legal-inner">
                <span>&copy; 2026 Eascess. Tüm hakları saklıdır.</span>
                <span>Web erişilebilirliği platformu. Varsayılan hedef: WCAG 2.2 AAA.</span>
            </div>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
