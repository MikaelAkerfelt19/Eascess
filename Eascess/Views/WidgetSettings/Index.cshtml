@using Eascess_Application.DTOs
@model WidgetSettingDto
@{
    ViewData["Title"] = "Widget Stüdyo";
    ViewData["Active"] = "widget";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}

<!-- Topbar -->
<div class="ea-topbar">
    <div>
        <div class="ea-topbar-eyebrow">
            <a asp-controller="Domains" asp-action="Script" asp-route-id="@Model.DomainId" style="color:var(--ink-500)">@Model.DomainUrl</a> / Ayarlar
        </div>
        <h1 class="ea-topbar-title">Widget Stüdyo</h1>
    </div>
</div>

@if (TempData["Success"] is string msg)
{
    <div class="ea-alert ea-alert--success">✓ @msg</div>
}

<div style="display:grid;grid-template-columns:1fr 1.2fr;gap:18px;align-items:start">

    <!-- Ayarlar formu -->
    <div class="ea-card" style="padding:24px">
        <form asp-action="Update" asp-controller="WidgetSettings" method="post" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="DomainId" />
            <input type="hidden" asp-for="DomainUrl" />

            <!-- Tema rengi -->
            <div style="margin-bottom:20px">
                <label class="ea-label">Tema Rengi</label>
                <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
                    <input type="color" asp-for="ThemeColor" id="color-input"
                           style="width:44px;height:44px;border:1px solid var(--cream-300);border-radius:var(--r-sm);background:white;cursor:pointer;padding:3px" />
                    <input type="text" id="color-text" value="@Model.ThemeColor"
                           class="ea-input" style="width:120px"
                           oninput="syncColor(this.value)" placeholder="#38bdf8" />
                    <div style="display:flex;gap:6px;flex-wrap:wrap">
                        @foreach (var c in new[] { "#38bdf8", "#818cf8", "#c084fc", "#22d3ee", "#4ade80", "#fb923c", "#f87171", "#facc15" })
                        {
                            <button type="button" onclick="setColor('@c')"
                                    style="width:22px;height:22px;background:@c;border:2px solid white;border-radius:50%;cursor:pointer;box-shadow:0 0 0 1px var(--cream-300);transition:transform .15s"
                                    onmouseover="this.style.transform='scale(1.2)'" onmouseout="this.style.transform='scale(1)'">
                            </button>
                        }
                    </div>
                </div>
                <p style="font-size:12px;color:var(--ink-500);margin:6px 0 0">Widget butonunun arka plan rengi</p>
            </div>

            <!-- Konum -->
            <div style="margin-bottom:20px">
                <label class="ea-label">Konum</label>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:6px;max-width:300px">
                    @foreach (var pos in new[] {
                        ("bottom-right", "Sağ Alt"),
                        ("bottom-left",  "Sol Alt"),
                        ("top-right",    "Sağ Üst"),
                        ("top-left",     "Sol Üst"),
                    })
                    {
                        <label style="display:flex;align-items:center;gap:8px;padding:10px 12px;border:1px solid var(--cream-300);border-radius:var(--r-sm);cursor:pointer;font-size:13px;transition:border-color .15s,background .15s;@(Model.Position == pos.Item1 ? "border-color:var(--teal-600);background:oklch(96% 0.04 190)" : "background:white")">
                            <input type="radio" name="Position" value="@pos.Item1"
                                   @(Model.Position == pos.Item1 ? "checked" : "")
                                   style="accent-color:var(--teal-600)"
                                   />
                            @pos.Item2
                        </label>
                    }
                </div>
            </div>

            <!-- Dil -->
            <div style="margin-bottom:20px">
                <label class="ea-label" asp-for="Language">Dil</label>
                <select asp-for="Language" class="ea-input" style="max-width:180px">
                    <option value="tr">Türkçe</option>
                    <option value="en">İngilizce</option>
                </select>
            </div>

            <!-- Marka özelleştirme -->
            <div style="margin-bottom:20px;padding:16px;background:var(--cream-50,#fafaf9);border:1px solid var(--cream-300);border-radius:var(--r-md)">
                <div style="font-size:13px;font-weight:600;color:var(--ink-700);margin-bottom:12px">Marka Özelleştirme</div>

                <div style="margin-bottom:12px">
                    <label class="ea-label" asp-for="LogoUrl">Logo URL <span style="font-weight:400;color:var(--ink-500)">(isteğe bağlı)</span></label>
                    <input type="url" asp-for="LogoUrl" class="ea-input" placeholder="https://example.com/logo.png"
                           oninput="updateBrandPreview()" />
                    <p style="font-size:12px;color:var(--ink-500);margin:4px 0 0">Widget başlık alanında görünen logo. Önerilen: 22px yükseklik, şeffaf PNG.</p>
                </div>

                <div style="margin-bottom:12px">
                    <label class="ea-label" asp-for="WidgetTitle">Başlık Metni <span style="font-weight:400;color:var(--ink-500)">(isteğe bağlı)</span></label>
                    <input type="text" asp-for="WidgetTitle" class="ea-input" placeholder="Erişilebilirlik Araçları" maxlength="30"
                           oninput="updateBrandPreview()" />
                    <p style="font-size:12px;color:var(--ink-500);margin:4px 0 0">Boş bırakılırsa varsayılan dil metni kullanılır.</p>
                </div>

                <div style="display:flex;align-items:center;justify-content:space-between;gap:16px">
                    <div>
                        <div style="font-size:13px;font-weight:500;color:var(--ink-800)">"Eascess ile güçlendirildi" Göster</div>
                        <div style="font-size:12px;color:var(--ink-500)">Widget altında marka ataması</div>
                    </div>
                    <label style="position:relative;display:inline-block;width:46px;height:26px;flex-shrink:0">
                        <input type="checkbox" asp-for="PoweredByVisible"
                               style="opacity:0;width:0;height:0"
                               id="pb-toggle" />
                        <span id="pb-slider"
                              onclick="togglePoweredBy()"
                              style="position:absolute;inset:0;border-radius:26px;cursor:pointer;transition:.3s;background:@(Model.PoweredByVisible ? "var(--indigo-700)" : "var(--cream-300)")">
                            <span style="position:absolute;height:20px;width:20px;left:@(Model.PoweredByVisible ? "23px" : "3px");bottom:3px;background:white;border-radius:50%;transition:.3s;box-shadow:0 1px 3px rgba(0,0,0,.2)" id="pb-thumb"></span>
                        </span>
                    </label>
                </div>
            </div>

            <!-- Yapay zeka alt metin -->
            <div style="margin-bottom:24px;padding:16px;background:var(--cream-100);border:1px solid var(--cream-300);border-radius:var(--r-md);display:flex;align-items:center;justify-content:space-between;gap:16px">
                <div>
                    <div style="font-size:14px;font-weight:600;color:var(--ink-900)">Yapay Zeka Alt Metin</div>
                    <div style="font-size:12px;color:var(--ink-500);margin-top:2px">Gemini 2.5 ile eksik alt metinleri otomatik oluştur</div>
                </div>
                <label style="position:relative;display:inline-block;width:46px;height:26px;flex-shrink:0">
                    <input type="checkbox" asp-for="IsAiEnabled"
                           style="opacity:0;width:0;height:0"
                           id="ai-toggle" />
                    <span id="ai-slider"
                          onclick="toggleAi()"
                          style="position:absolute;inset:0;border-radius:26px;cursor:pointer;transition:.3s;background:@(Model.IsAiEnabled ? "var(--indigo-700)" : "var(--cream-300)")">
                        <span style="position:absolute;height:20px;width:20px;left:@(Model.IsAiEnabled ? "23px" : "3px");bottom:3px;background:white;border-radius:50%;transition:.3s;box-shadow:0 1px 3px rgba(0,0,0,.2)" id="ai-thumb"></span>
                    </span>
                </label>
            </div>

            <div style="display:flex;gap:8px">
                <button type="submit" class="ea-btn ea-btn-brand">Kaydet</button>
                <a asp-controller="Domains" asp-action="Script" asp-route-id="@Model.DomainId" class="ea-btn ea-btn-ghost">İptal</a>
            </div>
        </form>
    </div>

    <!-- Canlı önizleme -->
    <div class="ea-card" style="padding:20px">
        <div style="font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--ink-500);margin-bottom:14px">Canlı Önizleme</div>
        <div style="border:1px solid var(--cream-300);border-radius:var(--r-md);overflow:hidden">
            <div style="display:flex;align-items:center;gap:8px;padding:8px 12px;background:var(--cream-100);border-bottom:1px solid var(--cream-300)">
                <div style="display:flex;gap:4px">
                    <span style="width:9px;height:9px;border-radius:50%;background:#fc615d;display:block"></span>
                    <span style="width:9px;height:9px;border-radius:50%;background:#fdbc40;display:block"></span>
                    <span style="width:9px;height:9px;border-radius:50%;background:#34c749;display:block"></span>
                </div>
                <div style="flex:1;text-align:center;font-size:11px;color:var(--ink-500);font-family:var(--font-mono);background:white;border:1px solid var(--cream-300);border-radius:4px;padding:3px 8px">orneksite.com</div>
            </div>
            <iframe id="preview-iframe"
                    src="/widget-demo.html"
                    title="Widget canlı önizleme"
                    sandbox="allow-scripts allow-same-origin"
                    style="width:100%;height:560px;border:none;display:block"></iframe>
        </div>
        <p style="font-size:12px;color:var(--ink-500);margin:8px 0 0">Gerçek widget Shadow DOM içinde izole çalışır. Değişiklikler anında yansır.</p>
    </div>

</div>

@section Scripts {
    <script>
        const colorInput   = document.getElementById('color-input');
        const colorText    = document.getElementById('color-text');
        const previewFrame = document.getElementById('preview-iframe');

        function getCurrentConfig() {
            return {
                themeColor:       colorInput.value,
                position:         document.querySelector('input[name="Position"]:checked')?.value || 'bottom-right',
                language:         document.getElementById('Language')?.value || 'tr',
                isAiEnabled:      document.getElementById('ai-toggle')?.checked || false,
                poweredByVisible: document.getElementById('pb-toggle')?.checked !== false,
                logoUrl:          document.getElementById('LogoUrl')?.value || '',
                widgetTitle:      document.getElementById('WidgetTitle')?.value || '',
            };
        }

        function pushConfigToPreview() {
            if (!previewFrame?.contentWindow) return;
            previewFrame.contentWindow.postMessage(
                { type: 'eascess-config-update', config: getCurrentConfig() },
                '*'
            );
        }

        function syncColor(val) {
            if (/^#[0-9a-fA-F]{6}$/.test(val)) {
                colorInput.value = val;
                pushConfigToPreview();
            }
        }

        function setColor(c) {
            colorInput.value = c;
            colorText.value  = c;
            pushConfigToPreview();
        }

        // iframe yüklendikten sonra mevcut config'i gönder
        previewFrame?.addEventListener('load', function () {
            setTimeout(pushConfigToPreview, 300);
        });

        // Tüm form girdilerine listener bağla
        colorInput?.addEventListener('input', function () {
            colorText.value = colorInput.value;
            pushConfigToPreview();
        });
        document.querySelectorAll('input[name="Position"]').forEach(r =>
            r.addEventListener('change', pushConfigToPreview)
        );
        document.getElementById('Language')?.addEventListener('change', pushConfigToPreview);
        document.getElementById('LogoUrl')?.addEventListener('input', pushConfigToPreview);
        document.getElementById('WidgetTitle')?.addEventListener('input', pushConfigToPreview);

        // Toggle switch'ler
        const aiToggle = document.getElementById('ai-toggle');
        const aiSlider = document.getElementById('ai-slider');
        const aiThumb  = document.getElementById('ai-thumb');

        function toggleAi() {
            aiToggle.checked = !aiToggle.checked;
            const on = aiToggle.checked;
            aiSlider.style.background = on ? 'var(--indigo-700)' : 'var(--cream-300)';
            aiThumb.style.left = on ? '23px' : '3px';
            pushConfigToPreview();
        }

        const pbToggle = document.getElementById('pb-toggle');
        const pbSlider = document.getElementById('pb-slider');
        const pbThumb  = document.getElementById('pb-thumb');

        function togglePoweredBy() {
            pbToggle.checked = !pbToggle.checked;
            const on = pbToggle.checked;
            pbSlider.style.background = on ? 'var(--indigo-700)' : 'var(--cream-300)';
            pbThumb.style.left = on ? '23px' : '3px';
            pushConfigToPreview();
        }

        // updateBrandPreview artık pushConfigToPreview ile kapsanıyor
        function updateBrandPreview() { pushConfigToPreview(); }
    </script>
}
